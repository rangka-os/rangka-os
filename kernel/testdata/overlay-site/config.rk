# yaml-language-server: $schema=https://rangka.dev/schema/0.4/config.json
locale: id-ID
currency: IDR
timezone: Asia/Jakarta
tax: {ppn_rate: 12, dpp_ratio: 11/12, pkp: true}
numbering:
  sales_invoice: INV-{YYYY}-{#####}
apps: [core, crm, sales]
plan: tumbuh
theme: kopi_senja
layout: crm_first
sso: {domains: [kopisenja.id], required: false}
ai: {enabled: true, auto_apply: never, approvers: [owner, sales_manager]}
