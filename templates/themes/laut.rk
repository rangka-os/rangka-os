# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/theme.json
# Blue actions and selection on cool slate neutrals (contract 0065 §3). Tokens are derived from accent, button and neutral by the kernel.
name: laut
label: {id: Laut, en: Sea}
extends: rangka/standard
accent: '#0c66e4'
button: accent
neutral: slate
