# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: tutup_sesi_on_submit
on: tutup_sesi.submitted
steps:
  - {find: sesi_kasir, where: name == event.shift, as: s}
  - update: s
    if: s != null
    set: {state: "'closed'"}
  - create: setoran
    if: s != null
    set: {outlet: s.outlet, shift: s.name, amount: event.counted_cash}
