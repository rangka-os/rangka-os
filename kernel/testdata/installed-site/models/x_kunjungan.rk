# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: x_kunjungan
label: {id: Kunjungan}
title_field: catatan
fields:
  - {name: catatan, type: data, label: {id: Catatan}, required: true}
  - {name: peluang, type: link, to: deal, label: {id: Peluang}}
  - {name: pelanggan, type: link, to: customer, label: {id: Pelanggan}}
permissions:
  - {role: sales_rep, read: true, create: true}
