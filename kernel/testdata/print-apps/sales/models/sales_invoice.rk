# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.4/model.json
name: sales_invoice
label: {id: Faktur penjualan}
is_submittable: true
naming: INV-{YYYY}-{#####}
title_field: customer
fields:
  - {name: posting_date, type: date, label: {id: Tanggal faktur}, required: true, in_list: true}
  - {name: due_date, type: date, label: {id: Jatuh tempo}}
  - {name: customer, type: link, to: customer, label: {id: Pelanggan}, required: true, in_list: true}
  - {name: customer_po, type: data, label: {id: No. PO pelanggan}}
  - {name: quotation, type: link, to: quotation, label: {id: Penawaran}}
  - {name: items, type: table, of: sales_invoice_item, label: {id: Barang dan jasa}}
  - {name: subtotal, type: currency, label: {id: Subtotal}}
  - {name: discount_amount, type: currency, label: {id: Diskon}}
  - {name: down_payment, type: currency, label: {id: Uang muka}}
  - {name: dpp, type: currency, label: {id: DPP nilai lain}}
  - {name: ppn, type: currency, label: {id: PPN}}
  - {name: grand_total, type: currency, label: {id: Total}, in_list: true}
  - {name: currency, type: data, label: {id: Mata uang}}
  - {name: notes, type: text, label: {id: Catatan}}
