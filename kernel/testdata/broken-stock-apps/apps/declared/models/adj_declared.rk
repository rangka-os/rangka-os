# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
# stock_adjustment written as a declaration (equivalence test)
name: adj_declared
is_submittable: true
naming: ADJD-{#####}
on_submit: [stock.post_moves]
on_cancel: [stock.reverse_moves]
stock:
  date: reason
  moves:
    - {lines: items, out: outlet, reason: waste, if: "doc.reason == 'waste'"}
    - {lines: items, out: outlet, reason: adjustment, if: "doc.reasn != 'waste' && line.qtyy > 0"}
fields:
  - {name: outlet, type: link, to: outlet, required: true}
  - {name: adjustment_date, type: date, default: today(), required: true}
  - {name: reason, type: select, required: true, options: [{value: waste, label: {id: waste}}, {value: other, label: {id: other}}]}
  - {name: items, type: table, of: adj_declared_item, min_rows: 1}
