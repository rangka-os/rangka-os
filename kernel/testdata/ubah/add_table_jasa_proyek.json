        {
          "op": "add",
          "path": "/fields",
          "value": [
            {
              "name": "tanggal",
              "type": "date",
              "label": {
                "id": "Tanggal"
              }
            }
          ]
        },
        {
          "op": "add",
          "path": "/views",
          "value": {
