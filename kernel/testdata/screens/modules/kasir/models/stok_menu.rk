# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
# Stock of a menu item per outlet (like rangka-apps stock_balance): the counter's badges read it (contract 0039).
name: stok_menu
label: {id: Stok menu}
naming: STK-{####}
fields:
  - {name: menu, type: link, to: menu, label: {id: Menu}, required: true, in_list: true}
  - {name: outlet, type: data, label: {id: Outlet}, required: true, in_list: true}
  - {name: qty, type: float, label: {id: Qty}, in_list: true}
permissions:
  - {role: kasir, read: true}
