# Rangka OS settings for {{NAME}}. The rangka CLI reads this file; values already in the environment win.
DATABASE_URL=postgres://rangka:rangka@localhost:54329/rangka?sslmode=disable
RANGKA_APPS=apps
RANGKA_MODULES=modules
RANGKA_SITE=site
RANGKA_CONNECTORS=connectors
RANGKA_FIXTURES=fixtures
RANGKA_ORG={{SLUG}}
RANGKA_ADDR=:8080
# Owner account created by `npm run setup` (rangka seed)
RANGKA_OWNER_EMAIL={{OWNER_EMAIL}}
RANGKA_OWNER_PASSWORD={{OWNER_PASSWORD}}
