# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.4/model.json
name: quotation
is_submittable: true
naming: QUO-{YYYY}-{#####}
fields:
  - {name: customer, type: link, to: customer, required: true}
  - {name: subject, type: data, required: true}
  - {name: rfq_ref, type: data}
  - {name: quotation_date, type: date, default: today(), required: true}
  - {name: revision, type: int, default: '0', read_only: true}
  - {name: items, type: table, of: quotation_item, min_rows: 1}
  - {name: subtotal, type: currency, compute: 'items.map(i, i.amount).sum()'}
  - {name: outcome, type: select, default: "'open'", read_only: true, options: [{value: open, label: {id: open}}, {value: accepted, label: {id: accepted}}, {value: lost, label: {id: lost}}]}
  - {name: lost_reason, type: text, read_only: true}
actions:
  - {name: new_revision, label: {id: new_revision}, hook: quotation.revise, if: "docstatus == 1 && outcome == 'open'"}
  - {name: mark_outcome, label: {id: mark_outcome}, hook: quotation.mark_outcome, if: docstatus == 1}
  - {name: make_order, label: {id: make_order}, hook: orders.from_quotation, if: "docstatus == 1 && outcome == 'accepted'"}
approvals:
  - {name: cancel_check, on: cancel, when: "subject == 'Perlu persetujuan'", approvers: [owner]}
