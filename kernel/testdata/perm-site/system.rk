# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.4/system.json
# Smallest system.rk for the permission matrix test (no connectors, no notify channels).
db: {driver: postgres, url: '${DATABASE_URL}', pool: 10, isolation: shared}
cache: {driver: memory, max_mb: 64}
queue: {driver: postgres, workers: 2, retries: 3, dead_letter_after: 24h}
scheduler: {driver: internal, timezone: Asia/Jakarta}
realtime: {driver: postgres, transports: [sse]}
auth:
  issuer: http://localhost:8080
  session_ttl: 24h
secrets: {driver: env}
audit: {enabled: true, retention_days: 365}
