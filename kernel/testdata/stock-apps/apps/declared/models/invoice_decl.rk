# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: invoice_decl
is_submittable: true
naming: INVD-{#####}
on_submit: [stock.post_moves]
on_cancel: [stock.reverse_moves]
stock:
  date: invoice_date
  moves:
    - {lines: items, out: outlet, reason: sale, cogs: cogs, if: "doc.delivery_note == ''"}
  cogs_total: cogs_total
fields:
  - {name: delivery_note, type: link, to: delivery_note}
  - {name: outlet, type: link, to: outlet, required: true}
  - {name: invoice_date, type: date, required: true}
  - {name: items, type: table, of: delivery_note_item, min_rows: 1}
  - {name: cogs_total, type: currency, read_only: true}
