# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: stock_transfer
label: {id: Transfer stok, en: Stock transfer}
icon: stock
is_submittable: true
naming: TRF-{YYYY}-{#####}
on_submit: [stock.post_moves]
on_cancel: [stock.reverse_moves]
permissions:
  - {role: head_office, read: true, create: true, write: true, delete: true, submit: true, cancel: true, amend: true, export: true, print: true}
  - {role: outlet_staff, read: true}
fields:
  - name: from_outlet
    type: link
    to: outlet
    label: {id: Dari outlet}
    required: true
    in_list: true
  - name: to_outlet
    type: link
    to: outlet
    label: {id: Ke outlet}
    required: true
    in_list: true
  - name: transfer_date
    type: date
    label: {id: Tanggal}
    default: today()
    required: true
    in_list: true
  - name: state
    type: select
    label: {id: Status kirim}
    read_only: true
    in_list: true
    chip: true
    options:
      - {value: in_transit, label: {id: Dalam perjalanan}}
      - {value: partly_received, label: {id: Diterima sebagian}}
      - {value: received, label: {id: Diterima}}
  - name: items
    type: table
    of: stock_transfer_item
    label: {id: Barang}
    min_rows: 1
  - name: notes
    type: text
    label: {id: Catatan}
rules:
  - name: different_outlets
    on: save
    check: from_outlet != to_outlet
    message: {id: Outlet asal dan tujuan tidak boleh sama}
  - name: qty_positive
    on: save
    check: "items.map(i, i.qty <= 0 ? 1 : 0).sum() == 0"
    message: {id: Jumlah barang harus lebih dari 0}
views:
  list:
    columns: [name, from_outlet, to_outlet, transfer_date, state, status]
    sort: -transfer_date
  form:
    layout:
      - section: {id: Transfer}
        columns:
          - [from_outlet, to_outlet, transfer_date, state]
      - section: {id: Barang}
        fields: [items]
      - section: {id: Catatan}
        fields: [notes]
