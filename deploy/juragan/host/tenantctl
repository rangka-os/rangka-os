#!/usr/bin/env bash
# tenantctl: create and run many Juragan tenants on one machine (one kernel + one database per tenant).
#
#   tenantctl [--env file] host-up                      start the shared Postgres and Caddy (idempotent)
#   tenantctl [--env file] create <id> --bundle <dir> --owner-email <email> [--host <name>] [--tag <tag>] [--org <org>]
#                                                       [--plan <plan>]; owner password from RANGKA_OWNER_PASSWORD (env only)
#   tenantctl [--env file] list | status <id> | health [<id>]
#   tenantctl [--env file] upgrade <id> --tag <tag> [--bundle <dir>]   backup first, then the new pinned release
#   tenantctl [--env file] backup <id>|all              encrypted archive per tenant, local + off-box (../backup/backup.sh)
#   tenantctl [--env file] drill <id>|all --identity <age key> [--archive <file>] [--max-age <hours>]
#                                                       restore the newest archive into a throwaway Postgres, boot it
#   tenantctl [--env file] suspend <id> | resume <id> | restart <id> | logs <id> [lines]
#   tenantctl [--env file] kernel <id> <rangka args...>  one-off CLI (user add, plan set, ...) on the tenant's pin
#   tenantctl [--env file] delete <id> --confirm <id> [--force]       final backup, then database, role, files
#   tenantctl [--env file] host-down [--volumes]        stop the shared services (tests); --volumes also drops all data
#
# A bundle is what a tenant runs: apps/, modules/, site/ (config.rk, system.rk, ...), optional fixtures/<org>/ and
# connectors/. The builder (Juragan Cloud, or the local shim) writes it from the onboarding answers. Files under
# $HOST_DIR: tenants/<id>/ (the bundle + data/ + backups/, mounted at /srv), registry/<id>.env (no secrets),
# secrets/<id>.env (mode 600), caddy/<id>.caddy, backups/<id>/, upgrades/, drill.log. See README.md.
# Each tenant kernel sits on its own Docker network (juragan-t-<id>) that only Postgres and Caddy join, so tenants
# cannot reach each other. Runs with bash 3.2 (macOS) as well as bash 5.
set -Eeuo pipefail
umask 077

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$HERE/.env"
RESERVED=" postgres template0 template1 jasa fnb www app api admin mail juragan rangka caddy backup host drill status "
LOCKED=""
LOCK_ME=""

log() { echo "tenantctl: $*" >&2; }
die() { log "$*"; exit 1; }
usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# ---------- configuration
env_get() { # env_get <file> <key> [default]: last KEY=value line, never sourced
  local v=""
  [ -f "$1" ] && v="$(grep -E "^$2=" "$1" | tail -1 | cut -d= -f2- || true)"
  echo "${v:-${3:-}}"
}
cfg() { env_get "$ENV_FILE" "$1" "${2:-}"; }

load_config() {
  [ -f "$ENV_FILE" ] || die "env file not found: $ENV_FILE (copy host.env.example)"
  HOST_DIR="$(cfg HOST_DIR)"
  [ -n "$HOST_DIR" ] || die "HOST_DIR is not set in $ENV_FILE"
  case "$HOST_DIR" in /*) ;; *) die "HOST_DIR must be an absolute path" ;; esac
  HOST_PROJECT="$(cfg HOST_PROJECT juragan-host)"
  [[ "$HOST_PROJECT" =~ ^[a-z0-9][a-z0-9_-]{0,40}$ ]] || die "HOST_PROJECT must be lowercase letters, digits, - or _"
  HOST_NETWORK="$(cfg HOST_NETWORK juragan-tenants)"
  DEFAULT_TAG="$(cfg RANGKA_TAG)"
  KERNEL_TARGET="$(cfg KERNEL_TARGET pdf)"
  TENANT_DOMAIN="$(cfg TENANT_DOMAIN juragan.ai)"
  TLS_MODE="$(cfg TLS_MODE acme)"
  ACME_EMAIL="$(cfg ACME_EMAIL)"
  HTTP_PORT="$(cfg HTTP_PORT 80)"
  HTTPS_PORT="$(cfg HTTPS_PORT 443)"
  POSTGRES_IMAGE="$(cfg POSTGRES_IMAGE postgres:16-alpine)"
  case "$TLS_MODE" in
    acme) [ -n "$ACME_EMAIL" ] || die "TLS_MODE=acme needs ACME_EMAIL" ;;
    internal|off) ;;
    *) die "TLS_MODE must be acme, internal or off" ;;
  esac
  mkdir -p "$HOST_DIR/tenants" "$HOST_DIR/registry" "$HOST_DIR/secrets" "$HOST_DIR/caddy" "$HOST_DIR/backups" "$HOST_DIR/upgrades"
  chmod 700 "$HOST_DIR/secrets" "$HOST_DIR/upgrades"
  # every ${NAME} the compose files interpolate: compose lets the caller's environment win over --env-file, so these are
  # unset before each compose call (a RANGKA_TAG exported in the shell must never move a tenant off its pin)
  COMPOSE_VARS="$(grep -ohE '\$\{[A-Za-z_][A-Za-z0-9_]*' "$HERE/compose.yaml" "$HERE/tenant.compose.yaml" | cut -c3- | sort -u | tr '\n' ' ')"
}

dc() { # docker compose with the interpolation variables removed from the environment (they come from the env files)
  (
    for v in $COMPOSE_VARS COMPOSE_FILE COMPOSE_PROJECT_NAME COMPOSE_PROFILES COMPOSE_ENV_FILES; do unset "$v"; done
    exec docker compose "$@"
  )
}
hc() { # docker compose for the shared services (+ HOST_COMPOSE_OVERRIDE, e.g. a local [::1] port for *.localhost)
  local files=(-f "$HERE/compose.yaml") o
  o="$(cfg HOST_COMPOSE_OVERRIDE)"
  [ -z "$o" ] || files+=(-f "$o")
  dc -p "$HOST_PROJECT" --project-directory "$HERE" --env-file "$ENV_FILE" "${files[@]}" "$@"
}
# tenant_project <id>: the tenant's compose project and network. Named per host so two hosts on one Docker daemon (a
# local demo and the e2e test) never share one; the production host (HOST_PROJECT=juragan-host) keeps juragan-t-<id>.
# Recorded in the registry at create; a tenant made before that keeps the old name (backfilled on first use).
tenant_project_for_new() { if [ "$HOST_PROJECT" = juragan-host ]; then echo "juragan-t-$1"; else echo "$HOST_PROJECT-t-$1"; fi; }
tenant_project() {
  local p
  p="$(reg "$1" TENANT_PROJECT)"
  if [ -z "$p" ]; then p="juragan-t-$1"; [ ! -f "$HOST_DIR/registry/$1.env" ] || reg_set "$1" TENANT_PROJECT "$p"; fi
  echo "$p"
}
tc() { # tc <id> <compose args...>: docker compose for one tenant
  local id="$1" p
  shift
  p="$(tenant_project "$id")"
  dc -p "$p" --project-directory "$HERE" --env-file "$ENV_FILE" \
    --env-file "$HOST_DIR/registry/$id.env" --env-file "$HOST_DIR/secrets/$id.env" -f "$HERE/tenant.compose.yaml" "$@"
}

# ---------- lock: one mutating tenantctl at a time per host (create, upgrade, delete, suspend, resume, restart, drill)
# The lock folder holds "<pid> <start time>". A holder counts as gone only when no process has that pid, or the pid now
# belongs to a process started at another time (pid reused after a reboot); a live process of another user (kill -0
# gives EPERM) still holds it. On exit a run removes the lock only while it is still its own.
proc_start() { LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null | tr -s ' ' | sed 's/^ //; s/ $//' || true; }
lock_alive() { # lock_alive "<pid> <start>": an old lock file with a pid only is judged by the pid
  local pid="${1%% *}" st="" now_st
  [ "$pid" = "$1" ] || st="${1#* }"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  now_st="$(proc_start "$pid")"
  [ -n "$now_st" ] || return 1
  [ -z "$st" ] || [ "$st" = "$now_st" ]
}
unlock() {
  if [ -n "$LOCKED" ] && [ "$(cat "$LOCKED/pid" 2>/dev/null || true)" = "$LOCK_ME" ]; then rm -rf "$LOCKED"; fi
  return 0
}
lock() {
  local l="$HOST_DIR/.lock" i owner
  LOCK_ME="$$ $(proc_start $$)"
  for i in $(seq 1 600); do
    if mkdir "$l" 2>/dev/null; then echo "$LOCK_ME" >"$l/pid"; LOCKED="$l"; trap unlock EXIT; return 0; fi
    owner="$(cat "$l/pid" 2>/dev/null || true)"
    # an empty pid file is a holder between its mkdir and its write: give it a few seconds before calling it dead
    if [ -z "$owner" ] && [ "$i" -lt 5 ]; then sleep 1; continue; fi
    if ! lock_alive "$owner"; then rm -rf "$l"; continue; fi
    [ $((i % 30)) -ne 1 ] || log "waiting for another tenantctl (pid ${owner%% *})"
    sleep 1
  done
  die "another tenantctl holds $l for 10 minutes; check it, remove the folder only if that process is gone"
}

# ---------- registry
reg() { env_get "$HOST_DIR/registry/$1.env" "$2" "${3:-}"; }
reg_set() { # reg_set <id> <key> <value>: rewrite one key, keep the rest; values are one line
  local f="$HOST_DIR/registry/$1.env" tmp
  case "$3" in *$'\n'*|*$'\r'*) die "registry value for $2 has a line break" ;; esac
  tmp="$f.tmp.$$"
  { [ -f "$f" ] && grep -vE "^$2=" "$f" || true; echo "$2=$3"; } >"$tmp"
  mv "$tmp" "$f"
}
reg_unset() { # reg_unset <id> <key>
  local f="$HOST_DIR/registry/$1.env" tmp
  tmp="$f.tmp.$$"
  { grep -vE "^$2=" "$f" || true; } >"$tmp"
  mv "$tmp" "$f"
}
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
tenant_ids() { # every registered id, optionally only with the given statuses
  local f id st
  for f in "$HOST_DIR"/registry/*.env; do
    [ -f "$f" ] || continue
    id="$(basename "$f" .env)"
    st="$(reg "$id" STATUS)"
    if [ $# -eq 0 ]; then echo "$id"; continue; fi
    case " $* " in *" $st "*) echo "$id" ;; esac
  done
}
need_tenant() {
  valid_id "$1" || die "invalid tenant id '$1'"
  [ -f "$HOST_DIR/registry/$1.env" ] || die "no tenant '$1'"
}
valid_id() { [[ "$1" =~ ^[a-z][a-z0-9]{2,29}$ ]]; }
valid_host() { [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$ ]]; }
valid_tag() { [[ "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[a-z]+\.[0-9]+)?$ ]]; }
valid_org() { [[ "$1" =~ ^[A-Za-z][A-Za-z0-9_-]{0,40}$ ]]; }
valid_plan() { [[ "$1" =~ ^[a-z][a-z0-9_]{0,30}$ ]]; }
secret() { od -An -N24 -tx1 /dev/urandom | tr -d ' \n'; }
export_secret() { export "$1=$(secret)"; } # export_secret <NAME>: a fresh random value, for `-e NAME` (never argv)
upper() { echo "$1" | tr '[:lower:]' '[:upper:]'; }
sha256_stdin() { if command -v sha256sum >/dev/null; then sha256sum | cut -c1-64; else shasum -a 256 | cut -c1-64; fi; }
sha256() { if command -v sha256sum >/dev/null; then printf %s "$1" | sha256sum | cut -c1-64; else printf %s "$1" | shasum -a 256 | cut -c1-64; fi; }

# ---------- images
kernel_image() { echo "juragan-tenant-kernel:$1-$2"; } # <tag> <target>
ensure_kernel_image() { # <tag> <target>
  docker image inspect "$(kernel_image "$1" "$2")" >/dev/null 2>&1 && return 0
  log "building $(kernel_image "$1" "$2") from the $1 GitHub Release"
  docker build -q --build-arg "RANGKA_TAG=$1" --target "$2" -t "$(kernel_image "$1" "$2")" "$HERE/kernel" >/dev/null
}
ensure_backup_image() {
  [ -n "$DEFAULT_TAG" ] || die "RANGKA_TAG is not set in $ENV_FILE"
  ensure_kernel_image "$DEFAULT_TAG" slim
  # rebuilt whenever backup.sh, restore.sh, lib.sh or the Dockerfile change (label juragan.scripts = their hash), so a
  # host never runs a stale copy of the scripts it ships with
  local want have
  want="$(cat "$HERE/../backup/lib.sh" "$HERE/../backup/backup.sh" "$HERE/../backup/restore.sh" "$HERE/backup/Dockerfile" | sha256_stdin)"
  have="$(docker image inspect -f '{{index .Config.Labels "juragan.scripts"}}' "juragan-host-backup:$DEFAULT_TAG" 2>/dev/null || true)"
  [ "$have" = "$want" ] && return 0
  log "building juragan-host-backup:$DEFAULT_TAG (backup scripts changed or image missing)"
  docker build -q -f "$HERE/backup/Dockerfile" --build-arg "KERNEL_IMAGE=$(kernel_image "$DEFAULT_TAG" slim)" \
    --label "juragan.scripts=$want" -t "juragan-host-backup:$DEFAULT_TAG" "$HERE/.." >/dev/null
}

# ---------- shared services and tenant networks
pg() { # pg <psql args...>: psql as the superuser inside the shared Postgres (stdin passes through)
  hc exec -T postgres psql -U postgres -v ON_ERROR_STOP=1 -qAtX "$@"
}
tenant_net() { tenant_project "$1"; }
shared_container() { hc ps -q "$1" 2>/dev/null | head -1; }
# attach_shared <id>: Postgres (alias postgres) and Caddy join the tenant's own network; idempotent. Recreating the
# shared containers drops these attachments, so host-up runs it for every tenant.
attach_shared() {
  local net c svc
  net="$(tenant_net "$1")"
  docker network inspect "$net" >/dev/null 2>&1 || docker network create --label "juragan.host=$HOST_PROJECT" --label "juragan.tenant=$1" "$net" >/dev/null
  for svc in postgres caddy; do
    c="$(shared_container "$svc")"
    [ -n "$c" ] || die "shared service $svc is not running (tenantctl host-up)"
    if ! docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$c" | tr ' ' '\n' | grep -qx "$net"; then
      docker network connect --alias "$svc" "$net" "$c"
    fi
  done
}
attached_shared() { # true when Postgres and Caddy are both on the tenant's network
  local net c svc
  net="$(tenant_net "$1")"
  for svc in postgres caddy; do
    c="$(shared_container "$svc")"
    [ -n "$c" ] || return 1
    docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$c" | tr ' ' '\n' | grep -qx "$net" || return 1
  done
}
detach_shared() { # detach_shared <id>: undo attach_shared and remove the network
  local net c svc
  net="$(tenant_net "$1")"
  docker network inspect "$net" >/dev/null 2>&1 || return 0
  for svc in postgres caddy; do
    c="$(shared_container "$svc")"
    [ -z "$c" ] || docker network disconnect -f "$net" "$c" >/dev/null 2>&1 || true
  done
  docker network rm "$net" >/dev/null 2>&1 || true
}
kernel_on_host_network() { # true when the tenant's kernel container is attached to HOST_NETWORK (pre-isolation tenant)
  local c
  c="$(docker ps -aq --filter "label=com.docker.compose.project=$(tenant_project "$1")" --filter label=com.docker.compose.service=kernel | head -1)"
  [ -n "$c" ] || return 1
  docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$c" | tr ' ' '\n' | grep -qx "$HOST_NETWORK"
}
host_up() {
  local id
  [ -n "$(cfg POSTGRES_PASSWORD)" ] || die "POSTGRES_PASSWORD is not set in $ENV_FILE"
  hc up -d --wait postgres caddy >/dev/null
  # tenant roles must not connect to the maintenance databases either
  pg -c 'REVOKE CONNECT ON DATABASE postgres FROM PUBLIC' -c 'REVOKE CONNECT ON DATABASE template1 FROM PUBLIC' >/dev/null
  for id in $(tenant_ids active suspended); do
    attach_shared "$id"
    # tenants made before the per-tenant cap and network: cap the role, and recreate a kernel still on HOST_NETWORK
    pg -c "ALTER ROLE \"$id\" CONNECTION LIMIT $(cfg TENANT_CONNECTION_LIMIT 20)" >/dev/null
    if [ "$(reg "$id" STATUS)" = active ] && kernel_on_host_network "$id"; then
      log "$id: kernel still on $HOST_NETWORK; recreating it on its own network"
      tc "$id" up -d --force-recreate kernel >/dev/null 2>&1
      wait_kernel "$id" || log "$id: kernel did not answer after the recreate; see tenantctl logs $id"
    fi
  done
  log "host up: postgres and caddy ($HOST_PROJECT)"
}
caddy_reload() {
  hc exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1
}
site_block() { # site_block <id> <tenant|suspended>
  local id="$1" mode="$2" host addr tls=""
  host="$(reg "$id" TENANT_HOST)"
  case "$TLS_MODE" in
    off) addr="http://$host" ;;
    internal) addr="$host"; tls="	tls internal" ;;
    acme) addr="$host"; tls="	tls $ACME_EMAIL" ;;
  esac
  {
    echo "# tenant $id: written by tenantctl, do not edit"
    echo "$addr {"
    [ -z "$tls" ] || echo "$tls"
    if [ "$mode" = tenant ]; then echo "	import tenant t-$id"; else echo "	import suspended"; fi
    echo "}"
  }
}
route() { # route <id> <tenant|suspended|none>: write (or remove) the Caddy site and reload; undo on a failed reload
  local id="$1" f="$HOST_DIR/caddy/$1.caddy" old=""
  [ -f "$f" ] && old="$(cat "$f")"
  if [ "$2" = none ]; then rm -f "$f"; else site_block "$id" "$2" >"$f"; chmod 644 "$f"; fi
  if ! caddy_reload; then
    if [ -n "$old" ]; then printf '%s\n' "$old" >"$f"; else rm -f "$f"; fi
    caddy_reload || true
    log "$id: Caddy rejected the new site; the previous routing is back"
    return 1
  fi
}

# probe_kernel <id>: HTTP status of the kernel itself, from Caddy (which shares the tenant's network)
probe_kernel() {
  hc exec -T caddy wget -q -S -O /dev/null "http://t-$1:8080/.well-known/openid-configuration" 2>&1 \
    | sed -n 's/^ *HTTP\/[0-9.]* \([0-9]*\).*/\1/p' | tail -1
}
# probe_route <id> [path]: HTTP status through Caddy on this machine (what a browser gets). For the default OIDC path a
# 200 counts only with an issuer in the body: Caddy answers an empty 200 for a host it has no site for.
probe_route() {
  local host path="${2:-/.well-known/openid-configuration}" code body
  host="$(reg "$1" TENANT_HOST)"
  body="$(mktemp "${TMPDIR:-/tmp}/tenantctl.XXXXXX")"
  if [ "$TLS_MODE" = off ]; then
    code="$(curl -s -o "$body" -m 10 -w '%{http_code}' -H "Host: $host" "http://127.0.0.1:$HTTP_PORT$path" || true)"
  else
    code="$(curl -sk -o "$body" -m 10 -w '%{http_code}' --resolve "$host:$HTTPS_PORT:127.0.0.1" "https://$host:$HTTPS_PORT$path" || true)"
  fi
  if [ "$code" = 200 ] && [ "$path" = /.well-known/openid-configuration ] && ! grep -q '"issuer"' "$body"; then code=200-empty; fi
  rm -f "$body"
  echo "$code"
}
wait_kernel() { # wait_kernel <id> [seconds]: wall-clock budget (a probe can itself take seconds)
  local code end=$((SECONDS + ${2:-90}))
  while [ "$SECONDS" -lt "$end" ]; do
    code="$(probe_kernel "$1" || true)"
    [ "$code" = 200 ] && return 0
    sleep 1
  done
  return 1
}

# orgs_in_config <config.rk>: keys of the block mapping `orgs:` (same reader as ../seed-orgs.sh)
orgs_in_config() {
  awk '
    /^orgs:[[:space:]]*(#.*)?$/ { in_orgs = 1; next }
    /^orgs:/ { print "FLOW"; exit }
    in_orgs && /^[^[:space:]#]/ { exit }
    in_orgs && match($0, /^  [A-Za-z0-9_-]+:/) { k = substr($0, 3, RLENGTH - 3); print k }
  ' "$1"
}

# fix_owner <dir>: the kernel runs as uid 65532 (distroless nonroot); hand the tenant folder to it
fix_owner() {
  docker run --rm -v "$1:/t" alpine:3.20 chown -R 65532:65532 /t >/dev/null
}
# remove_dir <parent> <name>: files written by the kernel belong to 65532, so remove them from a container.
# <name> is a validated id, a fixed name or <id>-<epoch>, never user text.
remove_dir() {
  docker run --rm -v "$1:/p" alpine:3.20 rm -rf "/p/$2" >/dev/null
}
check_bundle_links() { [ -z "$(find "$1" -type l -print -quit)" ] || die "bundle contains symlinks; backups refuse them"; }

# ---------- commands
cmd_create() {
  local id="${1:-}" bundle="" email="" host="" tag="" org="" plan="" d orgs=() o step out
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --bundle) bundle="${2:?}"; shift 2 ;;
      --owner-email) email="${2:?}"; shift 2 ;;
      --host) host="${2:?}"; shift 2 ;;
      --tag) tag="${2:?}"; shift 2 ;;
      --org) org="${2:?}"; shift 2 ;;
      --plan) plan="${2:?}"; shift 2 ;;
      *) usage ;;
    esac
  done
  valid_id "$id" || die "tenant id must be 3-30 lowercase letters and digits, starting with a letter (got '$id')"
  case "$RESERVED" in *" $id "*) die "'$id' is reserved" ;; esac
  [ ! -f "$HOST_DIR/registry/$id.env" ] || die "tenant '$id' exists or existed (status $(reg "$id" STATUS)); ids are never reused"
  [ -n "$bundle" ] && [ -d "$bundle" ] || die "--bundle <dir> is required"
  [[ "$email" =~ ^[^[:space:]@]+@[^[:space:]@]+$ ]] || die "--owner-email <email> is required"
  [ -n "${RANGKA_OWNER_PASSWORD:-}" ] || die "RANGKA_OWNER_PASSWORD is not set (environment only, never an argument)"
  tag="${tag:-$DEFAULT_TAG}"
  valid_tag "$tag" || die "tag must be a release tag such as v0.5.0-alpha.9 (got '$tag')"
  host="${host:-$id.$TENANT_DOMAIN}"
  valid_host "$host" || die "invalid host '$host'"
  [ -z "$plan" ] || valid_plan "$plan" || die "invalid plan '$plan'"
  for d in apps site; do [ -d "$bundle/$d" ] || die "bundle has no $d/"; done
  for d in config.rk system.rk; do [ -f "$bundle/site/$d" ] || die "bundle has no site/$d"; done
  grep -q "url: '\${DATABASE_URL}'" "$bundle/site/system.rk" || die "site/system.rk must read the database from \${DATABASE_URL} (db: {url: '\${DATABASE_URL}'})"
  grep -Eq 'files:.*path: \./data/files' "$bundle/site/system.rk" || die "site/system.rk must keep files in ./data/files (inside the backed-up data/)"
  check_bundle_links "$bundle"
  o="$(orgs_in_config "$bundle/site/config.rk")"
  [ "$o" != FLOW ] || die "site/config.rk writes orgs: in flow style; write it as a block mapping"
  if [ -n "$o" ]; then
    while IFS= read -r d; do valid_org "$d" || die "invalid org id '$d' in site/config.rk"; orgs+=("$d"); done <<<"$o"
    if [ -n "$org" ]; then
      case " ${orgs[*]} " in *" $org "*) ;; *) die "--org $org is not one of the orgs in site/config.rk (${orgs[*]})" ;; esac
    else
      org="${orgs[0]}"
    fi
  else
    org="${org:-$id}"
    orgs=("$org")
  fi
  valid_org "$org" || die "invalid org '$org'"
  [ -z "$(docker network ls -q --filter "name=^$(tenant_project_for_new "$id")$")" ] || die "Docker network $(tenant_project_for_new "$id") already exists (another host on this daemon with the same HOST_PROJECT?)"
  [ -z "$(reg_host_owner "$host")" ] || die "host $host is already used by tenant $(reg_host_owner "$host")"

  log "$id: creating ($host, $tag, org $org)"
  {
    echo "TENANT_ID=$id"
    echo "TENANT_ORG=$org"
    echo "TENANT_HOST=$host"
    echo "TENANT_PROJECT=$(tenant_project_for_new "$id")"
    echo "RANGKA_TAG=$tag"
    echo "STATUS=creating"
    echo "CREATED_AT=$(now)"
  } >"$HOST_DIR/registry/$id.env"
  printf 'DB_PASSWORD=%s\n' "$(secret)" >"$HOST_DIR/secrets/$id.env"
  chmod 600 "$HOST_DIR/secrets/$id.env"

  step="files"
  # set -E hands this trap to $(...) subshells too; only the main shell records the failure (a failed command inside an
  # `if out="$(...)"` test is handled there)
  trap 'if [ "$BASH_SUBSHELL" = 0 ]; then reg_set "$id" STATUS failed; reg_set "$id" FAILED_STEP "$step"; log "$id: FAILED at $step; inspect, then tenantctl delete $id --confirm $id --force (frees the id and host for a retry)"; fi' ERR
  mkdir -p "$HOST_DIR/tenants/$id"
  for d in apps modules site fixtures connectors; do
    [ -d "$bundle/$d" ] && cp -R "$bundle/$d" "$HOST_DIR/tenants/$id/$d"
  done
  mkdir -p "$HOST_DIR/tenants/$id/data/files" "$HOST_DIR/tenants/$id/backups"
  fix_owner "$HOST_DIR/tenants/$id"

  step="database"
  TENANT_PW="$(env_get "$HOST_DIR/secrets/$id.env" DB_PASSWORD)" hc exec -T -e TENANT_PW postgres \
    psql -U postgres -v ON_ERROR_STOP=1 -qX >/dev/null <<SQL
\getenv pw TENANT_PW
CREATE ROLE "$id" LOGIN NOSUPERUSER NOBYPASSRLS NOCREATEROLE NOCREATEDB CONNECTION LIMIT $(cfg TENANT_CONNECTION_LIMIT 20) PASSWORD :'pw';
CREATE DATABASE "$id" OWNER "$id";
REVOKE CONNECT ON DATABASE "$id" FROM PUBLIC;
SQL
  step="network"
  attach_shared "$id"

  step="image"
  ensure_kernel_image "$tag" "$KERNEL_TARGET"
  step="validate"
  out="$(tc "$id" run --rm -T --no-deps kernel validate 2>&1)" || { echo "$out" | grep -v '^ *Container ' | tail -15 >&2; false; }
  step="migrate"
  tc "$id" run --rm -T --no-deps kernel migrate | tail -1 >&2
  step="seed"
  for o in "${orgs[@]}"; do
    if [ -d "$HOST_DIR/tenants/$id/fixtures/$o" ]; then
      RANGKA_OWNER_EMAIL="$email" tc "$id" run --rm -T --no-deps -e RANGKA_OWNER_EMAIL -e RANGKA_OWNER_PASSWORD kernel seed --org "$o" --fixtures "/srv/fixtures/$o" | tail -1 >&2
    else
      RANGKA_OWNER_EMAIL="$email" tc "$id" run --rm -T --no-deps -e RANGKA_OWNER_EMAIL -e RANGKA_OWNER_PASSWORD kernel seed --org "$o" | tail -1 >&2
    fi
  done
  if [ -n "$plan" ]; then
    # contract 0028: the operator's plan (rk_site_plan) wins over config.rk `plan:`; a kernel before 0028 has no
    # `plan` command, and then config.rk's plan (written by the builder) is what the kernel reports
    step="plan"
    if out="$(tc "$id" run --rm -T --no-deps kernel plan set "$plan" --by tenantctl --note provisioning 2>&1)"; then
      reg_set "$id" PLAN "$plan"
      log "$id: plan $plan set"
    elif grep -q 'unknown command' <<<"$out"; then
      reg_set "$id" PLAN "$plan (config.rk)"
      log "$id: release $tag has no 'rangka plan' (contract 0028); plan comes from site/config.rk"
    else
      echo "$out" | grep -v '^ *Container ' | tail -3 >&2; false
    fi
  fi
  step="serve"
  tc "$id" up -d kernel >/dev/null 2>&1
  wait_kernel "$id" || { tc "$id" logs --tail 30 kernel >&2 || true; false; }
  step="route"
  route "$id" tenant
  trap - ERR
  reg_set "$id" STATUS active
  reg_set "$id" ACTIVE_AT "$(now)"
  log "$id: active, $(url_of "$id")/app/ (route $(probe_route "$id"))"
  url_of "$id"
}
reg_host_owner() { # tenant id that already has this host, if any (deleted tenants keep a hash of theirs: hosts are never reused)
  local f h
  h="$(sha256 "$1")"
  for f in "$HOST_DIR"/registry/*.env; do
    [ -f "$f" ] || continue
    if [ "$(env_get "$f" TENANT_HOST)" = "$1" ] || [ "$(env_get "$f" HOST_SHA256)" = "$h" ]; then basename "$f" .env; return 0; fi
  done
  return 0
}
url_of() {
  local host
  host="$(reg "$1" TENANT_HOST)"
  case "$TLS_MODE" in
    off) [ "$HTTP_PORT" = 80 ] && echo "http://$host" || echo "http://$host:$HTTP_PORT" ;;
    *) [ "$HTTPS_PORT" = 443 ] && echo "https://$host" || echo "https://$host:$HTTPS_PORT" ;;
  esac
}

cmd_list() {
  local id
  printf '%-30s %-10s %-16s %s\n' TENANT STATUS TAG HOST
  for id in $(tenant_ids); do
    printf '%-30s %-10s %-16s %s\n' "$id" "$(reg "$id" STATUS)" "$(reg "$id" RANGKA_TAG)" "$(reg "$id" TENANT_HOST -)"
  done
}

cmd_status() {
  need_tenant "$1"
  cat "$HOST_DIR/registry/$1.env"
  echo "kernel_http=$(probe_kernel "$1" || true)"
  echo "route_http=$(probe_route "$1")"
}

newest_local_backup() { # name of the newest local archive of <id>, or nothing
  ls "$HOST_DIR/backups/$1" 2>/dev/null | grep -E "^$1-[0-9]{8}T[0-9]{6}Z[.]tar([.]age)?$" | sort | tail -1 || true
}
stamp_epoch() { # stamp_epoch <archive name>: epoch of the UTC stamp in it
  local ts
  ts="$(echo "$1" | sed -En 's/^[a-z0-9]+-([0-9]{8})T([0-9]{2})([0-9]{2})([0-9]{2})Z[.]tar([.]age)?$/\1 \2:\3:\4/p')"
  [ -n "$ts" ] || return 1
  date -u -d "${ts% *} ${ts#* }" +%s 2>/dev/null || date -u -j -f '%Y%m%d %H:%M:%S' "$ts" +%s
}
epoch_of_iso() { date -u -d "$1" +%s 2>/dev/null || date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s; }
last_drill_failed() { # true when the newest drill line of <id> is FAILED (a failure alarms at once, not after the window)
  grep -E "^DRILL (PASSED|FAILED) $1 " "$HOST_DIR/drill.log" 2>/dev/null | tail -1 | grep -q '^DRILL FAILED '
}
last_drill_pass() { # epoch of the newest "DRILL PASSED <id>" line in drill.log, or nothing
  local t
  t="$(grep -E "^DRILL PASSED $1 " "$HOST_DIR/drill.log" 2>/dev/null | tail -1 | awk '{print $NF}' || true)"
  [ -z "$t" ] || epoch_of_iso "$t"
}

# health [<id>]: one line per tenant and one for the host; exit 1 on any problem (for a timer + dead man's switch)
cmd_health() {
  local ids=() id bad=0 k r b age size dbsize used max_age drill_max now_s ping since d
  max_age="$(cfg HEALTH_BACKUP_MAX_AGE_HOURS 26)"
  drill_max="$(cfg HEALTH_DRILL_MAX_AGE_HOURS 50)"
  now_s="$(date -u +%s)"
  if [ $# -gt 0 ]; then need_tenant "$1"; ids=("$1"); else
    while IFS= read -r id; do [ -n "$id" ] && ids+=("$id"); done <<<"$(tenant_ids active suspended)"
  fi
  for id in ${ids[@]+"${ids[@]}"}; do
    case "$(reg "$id" STATUS)" in
      suspended) r="$(probe_route "$id" /)"; [ "$r" = 503 ] || bad=1; echo "SUSPENDED $id route=$r"; continue ;;
      active) ;;
      *) echo "SKIP $id status=$(reg "$id" STATUS)"; continue ;;
    esac
    k="$(probe_kernel "$id" || true)"
    # the kernel needs Postgres on its network: a Postgres recreated outside host-up loses the tenant networks, and the
    # kernel then fails every login while its OIDC document still answers 200
    attached_shared "$id" || k="$k/no-db-net"
    r="$(probe_route "$id")"
    b="$(newest_local_backup "$id")"
    if [ -n "$b" ]; then age=$(( (now_s - $(stamp_epoch "$b")) / 3600 )); else age=-1; fi
    since=$(( (now_s - $(epoch_of_iso "$(reg "$id" ACTIVE_AT "$(now)")")) / 3600 ))
    d="$(last_drill_pass "$id")"
    if [ -n "$d" ]; then d=$(( (now_s - d) / 3600 )); else d=-1; fi
    size="$(du -sk "$HOST_DIR/tenants/$id" 2>/dev/null | cut -f1)"
    dbsize="$(pg -c "select pg_database_size('$id')/1024" 2>/dev/null || echo '?')"
    local verdict=OK why=""
    [ "$k" = 200 ] || { verdict=FAIL; why="$why kernel"; }
    [ "$r" = 200 ] || { verdict=FAIL; why="$why route"; }
    # a tenant younger than the window has not had its first night yet
    if [ "$age" -lt 0 ]; then [ "$since" -lt "$max_age" ] || { verdict=FAIL; why="$why no-backup"; }
    elif [ "$age" -gt "$max_age" ]; then verdict=FAIL; why="$why backup-age"; fi
    if [ "$d" -lt 0 ]; then [ "$since" -lt "$drill_max" ] || { verdict=FAIL; why="$why no-drill"; }
    elif [ "$d" -gt "$drill_max" ]; then verdict=FAIL; why="$why drill-age"; fi
    if last_drill_failed "$id"; then verdict=FAIL; why="$why drill-failed"; fi
    [ "$verdict" = OK ] || bad=1
    echo "$verdict $id kernel=$k route=$r backup_age_h=$age drill_age_h=$d files_kb=${size:-?} db_kb=$dbsize${why:+ problem:$why}"
  done
  used="$(df -P "$HOST_DIR" | awk 'NR==2 {gsub("%","",$5); print $5}')"
  if [ "$used" -ge "$(cfg HEALTH_DISK_MAX_PCT 85)" ]; then bad=1; echo "FAIL host disk_used_pct=$used"; else echo "OK host disk_used_pct=$used"; fi
  ping="$(cfg HEALTH_PING_URL)"
  if [ -n "$ping" ] && [ $# -eq 0 ]; then
    if [ "$bad" = 0 ]; then curl -fsS -m 10 -o /dev/null "$ping" || log "health ping failed"; else curl -fsS -m 10 -o /dev/null "$ping/fail" || true; fi
  fi
  [ "$bad" = 0 ]
}

# backup <id>|all: ../backup/backup.sh in the backup image, with BACKUP_PILOTS = the tenants and their passwords in the
# environment of the docker CLI (never argv)
cmd_backup() {
  local target="${1:-}" names=() id var flags=()
  [ -n "$target" ] || usage
  ensure_backup_image
  while IFS= read -r id; do [ -n "$id" ] && names+=("$id"); done <<<"$(tenant_ids active suspended)"
  [ "${#names[@]}" -gt 0 ] || die "no active or suspended tenant to back up"
  if [ "$target" != all ]; then
    need_tenant "$target"
    case " ${names[*]} " in *" $target "*) ;; *) die "$target is $(reg "$target" STATUS); only active and suspended tenants are backed up" ;; esac
  fi
  for id in "${names[@]}"; do
    var="$(upper "$id")_DB_PASSWORD"
    export "$var=$(env_get "$HOST_DIR/secrets/$id.env" DB_PASSWORD)"
    flags+=(-e "$var")
  done
  BACKUP_PILOTS="${names[*]}" hc --profile tools run --rm -T -e BACKUP_PILOTS "${flags[@]}" backup "$target"
}

# sweep_drills [<id>]: remove what a drill leaves when it is killed (containers, volumes, networks, restored folders,
# fetched archives); every drill object carries the label juragan.drill=<host project>
sweep_drills() {
  local f="label=juragan.drill=$HOST_PROJECT" x
  [ -z "${1:-}" ] || f="label=juragan.drill.tenant=$HOST_PROJECT/$1"
  x="$(docker ps -aq --filter "$f")"; [ -z "$x" ] || docker rm -f -v $x >/dev/null 2>&1 || true
  x="$(docker volume ls -q --filter "$f")"; [ -z "$x" ] || docker volume rm -f $x >/dev/null 2>&1 || true
  x="$(docker network ls -q --filter "$f")"; [ -z "$x" ] || docker network rm $x >/dev/null 2>&1 || true
  if [ -d "$HOST_DIR/drill" ]; then
    for x in "$HOST_DIR"/drill/*; do
      [ -e "$x" ] || continue
      x="$(basename "$x")"
      [[ "$x" =~ ^[a-z][a-z0-9]{2,29}-[0-9]+$ ]] || continue
      [ -z "${1:-}" ] || [ "${x%-*}" = "$1" ] || continue
      remove_dir "$HOST_DIR/drill" "$x" || true
    done
  fi
  if [ -z "${1:-}" ]; then rm -f "$HOST_DIR"/backups/drill-in/*; else rm -f "$HOST_DIR/backups/drill-in/$1-"*; fi
}

# drill <id>|all: newest archive (off-box, or --archive) -> throwaway Postgres on a network of its own -> restore.sh
# (checksums, ownership, exact table compare with the manifest) -> role NOSUPERUSER NOBYPASSRLS and RLS forced on every
# r_* table -> `migrate --dry-run` plans 0 statements -> the tenant's own release boots on it and answers 200.
# Every result goes to drill.log (PASSED / FAILED); health alarms on a stale PASSED.
cmd_drill() {
  local target="" archive="" identity="" max_age=48 ids=() id rc=0 epoch
  while [ $# -gt 0 ]; do
    case "$1" in
      --archive) archive="${2:?}"; shift 2 ;;
      --identity) identity="${2:?}"; shift 2 ;;
      --max-age) max_age="${2:?}"; shift 2 ;;
      -*) usage ;;
      *) target="$1"; shift ;;
    esac
  done
  [ -n "$target" ] || usage
  [[ "$max_age" =~ ^[0-9]+$ ]] || die "--max-age needs whole hours"
  if [ -z "$identity" ] && [ "$(cfg BACKUP_ALLOW_PLAINTEXT 0)" != 1 ]; then die "--identity <age private key file> is required"; fi
  [ -z "$identity" ] || [ -r "$identity" ] || die "cannot read $identity"
  if [ "$target" = all ]; then
    [ -z "$archive" ] || die "--archive needs one tenant"
    while IFS= read -r id; do [ -n "$id" ] && ids+=("$id"); done <<<"$(tenant_ids active suspended)"
  else
    need_tenant "$target"; ids=("$target")
  fi
  ensure_backup_image
  sweep_drills # leftovers of a killed run (we hold the lock, so no drill is running)
  for id in ${ids[@]+"${ids[@]}"}; do
    # a background subshell keeps errexit on inside drill_body (an `if`/`||` around a function would switch it off)
    epoch="$(date -u +%s)"
    ( set -e; drill_body "$id" "$archive" "$identity" "$max_age" "$epoch" ) &
    if wait $!; then :; else rc=1; echo "DRILL FAILED $id $(now)" | tee -a "$HOST_DIR/drill.log" >&2; fi
    sweep_drills "$id"
  done
  return "$rc"
}

drill_body() {
  local id="$1" archive="$2" identity="$3" max_age="$4" epoch="$5" name pgc kc net vol dir out n age tag img labels idfile
  pgc="juragan-drill-$id-$epoch"
  kc="$pgc-kernel"
  net="$pgc"
  vol="$pgc"
  dir="$HOST_DIR/drill/$id-$epoch"
  labels=(--label "juragan.drill=$HOST_PROJECT" --label "juragan.drill.tenant=$HOST_PROJECT/$id")
  mkdir -p "$dir/srv" "$HOST_DIR/backups/drill-in"

  if [ -n "$archive" ]; then
    [ -f "$archive" ] || { log "$id: $archive not found"; return 1; }
    name="$(basename "$archive")"
    cp "$archive" "$HOST_DIR/backups/drill-in/$name"
  else
    # shellcheck disable=SC2016 # runs inside the container
    name="$(hc --profile tools run --rm -T --no-deps --entrypoint bash backup -c '
      set -euo pipefail
      . /usr/local/bin/lib.sh
      n="$(newest_archive "$1")"
      rclone copyto "offbox:$BACKUP_BUCKET/$1/$n" "/backups/drill-in/$n" --s3-no-check-bucket
      echo "$n"' _ "$id" | tail -1)" || { log "$id: no off-box archive"; return 1; }
  fi
  [[ "$name" =~ ^$id-[0-9]{8}T[0-9]{6}Z[.]tar([.]age)?$ ]] || { log "$id: unexpected archive name '$name'"; return 1; }
  age=$(( ($(date -u +%s) - $(stamp_epoch "$name")) / 3600 ))
  log "$id: archive $name (${age} h old)"
  [ "$age" -le "$max_age" ] || { log "$id: archive is older than $max_age h"; return 1; }

  # throwaway Postgres on its own network and labelled volume; passwords reach containers by name (-e NAME), never argv
  docker network create "${labels[@]}" "$net" >/dev/null
  docker volume create "${labels[@]}" "$vol" >/dev/null
  export_secret POSTGRES_PASSWORD
  export_secret DRILL_PW
  docker run -d "${labels[@]}" --name "$pgc" --network "$net" -e POSTGRES_PASSWORD -v "$vol:/var/lib/postgresql/data" "$POSTGRES_IMAGE" >/dev/null
  for n in $(seq 1 60); do docker exec "$pgc" pg_isready -h 127.0.0.1 -U postgres >/dev/null 2>&1 && break; sleep 1; done
  sleep 1
  docker exec -i -e DRILL_PW "$pgc" psql -U postgres -v ON_ERROR_STOP=1 -qX >/dev/null <<SQL
\getenv pw DRILL_PW
CREATE ROLE "$id" LOGIN NOSUPERUSER NOBYPASSRLS NOCREATEROLE NOCREATEDB PASSWORD :'pw';
CREATE DATABASE "$id" OWNER "$id";
REVOKE CONNECT ON DATABASE "$id" FROM PUBLIC;
SQL
  fix_owner "$dir/srv"

  export "$(upper "$id")_DB_PASSWORD=$DRILL_PW"
  idfile=()
  [ -z "$identity" ] || idfile=(-v "$(cd "$(dirname "$identity")" && pwd)/$(basename "$identity"):/run/secrets/age-identity:ro")
  out="$dir/restore.out"
  if ! docker run --rm "${labels[@]}" --network "$net" -e "BACKUP_PILOTS=$id" -e "BACKUP_DB_HOST=$pgc" -e "$(upper "$id")_DB_PASSWORD" \
      -v "$dir/srv:/restore/$id" -v "$HOST_DIR/backups/drill-in:/drill-in:ro" ${idfile[@]+"${idfile[@]}"} \
      --entrypoint restore.sh "juragan-host-backup:$DEFAULT_TAG" "/drill-in/$name" "$id" >"$out" 2>&1; then
    tail -20 "$out" >&2; return 1
  fi
  grep -E '^restore: (checksums ok|method|every object)' "$out" >&2 || true

  # isolation: the restored role binds row-level security, and every model table has it enabled and forced
  n="$(docker exec "$pgc" psql -U postgres -d "$id" -qAtX -c "select rolsuper::int || ',' || rolbypassrls::int from pg_roles where rolname = '$id'")"
  [ "$n" = "0,0" ] || { log "$id: restored role is superuser or bypassrls ($n)"; return 1; }
  n="$(docker exec "$pgc" psql -U postgres -d "$id" -qAtX -c "select count(*) || '|' || count(*) filter (where not (relrowsecurity and relforcerowsecurity)) from pg_class where relkind = 'r' and relnamespace = 'public'::regnamespace and relname like 'r\_%'")"
  [ "${n%%|*}" -ge 1 ] && [ "${n#*|}" = 0 ] || { log "$id: row-level security check failed (tables|without forced RLS = $n)"; return 1; }

  tag="$(reg "$id" RANGKA_TAG)"
  img="$(kernel_image "$tag" slim)"
  ensure_kernel_image "$tag" slim
  export DATABASE_URL RANGKA_ORG
  DATABASE_URL="postgres://$id:$DRILL_PW@$pgc:5432/$id?sslmode=disable"
  RANGKA_ORG="$(reg "$id" TENANT_ORG)"
  out="$(docker run --rm "${labels[@]}" --network "$net" -e DATABASE_URL -e RANGKA_ORG \
    -e RANGKA_APPS=/srv/apps -e RANGKA_SITE=/srv/site -e RANGKA_MODULES=/srv/modules -e RANGKA_CONNECTORS=/srv/connectors \
    -v "$dir/srv:/srv" "$img" migrate --dry-run 2>&1)" || { echo "$out" | tail -5 >&2; log "$id: migrate --dry-run failed"; return 1; }
  n="$(echo "$out" | sed -n -E 's/^-- (risk [a-z]+: )?would apply ([0-9]+) statement\(s\);.*/\2/p' | tail -1)"
  [ "$n" = 0 ] || { log "$id: the restored database is not at the release's schema (migrate --dry-run: ${n:-no plan line})"; return 1; }
  docker run -d "${labels[@]}" --name "$kc" --network "$net" -e DATABASE_URL -e RANGKA_ORG \
    -e RANGKA_APPS=/srv/apps -e RANGKA_SITE=/srv/site -e RANGKA_MODULES=/srv/modules -e RANGKA_CONNECTORS=/srv/connectors \
    -e RANGKA_ADDR=:8080 -v "$dir/srv:/srv" "$img" serve >/dev/null
  for n in $(seq 1 60); do
    if docker run --rm "${labels[@]}" --network "$net" alpine:3.20 wget -q -O /dev/null "http://$kc:8080/.well-known/openid-configuration" 2>/dev/null; then
      n=ok; break
    fi
    sleep 1
  done
  [ "$n" = ok ] || { docker logs --tail 20 "$kc" >&2; log "$id: restored kernel did not answer"; return 1; }
  echo "DRILL PASSED $id $name $(now)" | tee -a "$HOST_DIR/drill.log"
}

cmd_suspend() {
  need_tenant "$1"
  [ "$(reg "$1" STATUS)" = active ] || die "$1 is $(reg "$1" STATUS), not active"
  route "$1" suspended
  tc "$1" stop kernel >/dev/null 2>&1
  reg_set "$1" STATUS suspended
  reg_set "$1" SUSPENDED_AT "$(now)"
  log "$1: suspended (data kept; route answers 503)"
}

cmd_resume() {
  need_tenant "$1"
  [ "$(reg "$1" STATUS)" = suspended ] || die "$1 is $(reg "$1" STATUS), not suspended"
  ensure_kernel_image "$(reg "$1" RANGKA_TAG)" "$KERNEL_TARGET"
  attach_shared "$1"
  tc "$1" up -d kernel >/dev/null 2>&1
  wait_kernel "$1" || die "$1: kernel did not come back; see: tenantctl logs"
  route "$1" tenant
  reg_set "$1" STATUS active
  log "$1: active again"
}

# upgrade <id> --tag <tag> [--bundle <dir>]: backup (must succeed) -> copy of the current code (apps, modules, connectors,
# fixtures) to upgrades/ -> new image and code -> `migrate --dry-run` must succeed -> restart (the kernel migrates on
# start and, with RANGKA_ENV=production, takes its own pre-migrate backup into backups/) -> 200. Anything failing puts
# the previous tag and code back.
cmd_upgrade() {
  local id="${1:-}" tag="" bundle="" prev d save out
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --tag) tag="${2:?}"; shift 2 ;;
      --bundle) bundle="${2:?}"; shift 2 ;;
      *) usage ;;
    esac
  done
  need_tenant "$id"
  [ "$(reg "$id" STATUS)" = active ] || die "$id is $(reg "$id" STATUS); upgrade an active tenant"
  valid_tag "$tag" || die "--tag must be a release tag such as v0.5.0-alpha.9"
  prev="$(reg "$id" RANGKA_TAG)"
  if [ -n "$bundle" ]; then [ -d "$bundle/apps" ] || die "bundle has no apps/"; check_bundle_links "$bundle"; fi
  log "$id: backup before upgrade"
  cmd_backup "$id"
  ensure_kernel_image "$tag" "$KERNEL_TARGET"
  save="$HOST_DIR/upgrades/$id-$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$save"
  for d in apps modules connectors fixtures; do [ ! -d "$HOST_DIR/tenants/$id/$d" ] || cp -R "$HOST_DIR/tenants/$id/$d" "$save/$d"; done
  prune_upgrades "$id" "$(cfg UPGRADE_KEEP 3)"
  reg_set "$id" PREV_TAG "$prev"
  if [ -n "$bundle" ]; then
    # code only; never site/ or data/, which belong to the tenant. A failed copy (disk full) puts the old code back.
    if ! replace_code "$id" "$bundle"; then
      upgrade_back "$id" "$prev" "$save" "$bundle"
      die "$id: copying the new code failed; still on $prev with its code"
    fi
  fi
  reg_set "$id" RANGKA_TAG "$tag"
  if ! out="$(tc "$id" run --rm -T --no-deps kernel migrate --dry-run 2>&1)"; then
    echo "$out" | grep -v '^ *Container ' | tail -8 >&2
    upgrade_back "$id" "$prev" "$save" "$bundle"
    die "$id: migrate --dry-run with $tag failed; still on $prev, nothing migrated"
  fi
  echo "$out" | grep -E '^-- ' | tail -3 >&2 || true
  tc "$id" up -d kernel >/dev/null 2>&1
  if wait_kernel "$id" "$(cfg UPGRADE_WAIT_SECONDS 900)"; then
    reg_set "$id" UPGRADED_AT "$(now)"
    log "$id: $prev -> $tag, route $(probe_route "$id") (previous code kept in $save)"
  else
    tc "$id" logs --tail 30 kernel >&2 || true
    upgrade_back "$id" "$prev" "$save" "$bundle"
    tc "$id" up -d kernel >/dev/null 2>&1 || true
    wait_kernel "$id" 60 || true
    die "$id: $tag did not come up; rolled back to $prev and its code. If $tag already migrated the database, restore the pre-upgrade archive (README: restore)"
  fi
}
replace_code() { # replace_code <id> <dir>: apps, modules, connectors, fixtures of <dir> into the tenant; 1 on any failure
  local d
  for d in apps modules connectors fixtures; do
    [ -d "$2/$d" ] || continue
    remove_dir "$HOST_DIR/tenants/$1" "$d" || return 1
    cp -R "$2/$d" "$HOST_DIR/tenants/$1/$d" || return 1
  done
  fix_owner "$HOST_DIR/tenants/$1" || return 1
}
upgrade_dirs() { # upgrade_dirs <id>: names of the saved code copies of <id>, oldest first (the glob sorts)
  local x
  for x in "$HOST_DIR/upgrades/$1-"*; do
    x="$(basename "$x")"
    [[ "$x" =~ ^$1-[0-9]{8}T[0-9]{6}Z$ ]] && echo "$x"
  done
  return 0
}
prune_upgrades() { # prune_upgrades <id> <keep>: drop all but the newest <keep> copies
  local n x
  n="$(upgrade_dirs "$1" | wc -l | tr -d ' ')"
  for x in $(upgrade_dirs "$1"); do
    [ "$n" -gt "$2" ] || break
    remove_dir "$HOST_DIR/upgrades" "$x" || true
    n=$((n - 1))
  done
}
upgrade_back() { # upgrade_back <id> <prev tag> <saved code dir> <bundle or empty>
  local d
  reg_set "$1" RANGKA_TAG "$2"
  if [ -n "$4" ]; then
    for d in apps modules connectors fixtures; do
      [ -d "$3/$d" ] || continue
      remove_dir "$HOST_DIR/tenants/$1" "$d"
      cp -R "$3/$d" "$HOST_DIR/tenants/$1/$d"
    done
    fix_owner "$HOST_DIR/tenants/$1"
  fi
}

# delete <id> --confirm <id> [--force]: only a suspended tenant (or a failed create with --force). Final backup first
# (kept until the off-box retention expires), then the kernel project, the database and role, the network, the routing,
# the files, the drill leftovers and the secret. The registry keeps a tombstone (id, a hash of the host, dates; no org
# or host in clear) so ids and hosts are never reused.
cmd_delete() {
  local id="${1:-}" confirm="" force=0 st host
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --confirm) confirm="${2:?}"; shift 2 ;;
      --force) force=1; shift ;;
      *) usage ;;
    esac
  done
  need_tenant "$id"
  [ "$confirm" = "$id" ] || die "type the id again: --confirm $id"
  st="$(reg "$id" STATUS)"
  case "$st" in
    suspended) ;;
    failed|creating) [ "$force" = 1 ] || die "$id is $st; add --force to clean up a failed create" ;;
    deleted) die "$id is already deleted" ;;
    *) die "$id is $st; suspend it first (and give the owner the export window agreed in the terms)" ;;
  esac
  # a create that never went live had no owner data and no live host: the whole entry goes, so the id and host can be
  # used again for the retry (an id that was ever active keeps its tombstone)
  local never_live=0
  [ "$st" = suspended ] || [ -n "$(reg "$id" ACTIVE_AT)" ] || never_live=1
  if [ "$st" = suspended ]; then
    log "$id: final backup"
    cmd_backup "$id" || { [ "$force" = 1 ] || die "$id: final backup failed; nothing deleted (--force deletes without it)"; }
  fi
  if [ -f "$HOST_DIR/secrets/$id.env" ]; then tc "$id" down --remove-orphans >/dev/null 2>&1 || true; fi
  [ -z "$(docker ps -q --filter "label=com.docker.compose.project=$(tenant_project "$id")")" ] || die "$id: its kernel is still running; nothing deleted"
  pg >/dev/null <<SQL || die "$id: could not drop the database; nothing else removed"
DROP DATABASE IF EXISTS "$id" WITH (FORCE);
DROP ROLE IF EXISTS "$id";
SQL
  detach_shared "$id"
  [ ! -f "$HOST_DIR/caddy/$id.caddy" ] || route "$id" none
  remove_dir "$HOST_DIR/tenants" "$id"
  sweep_drills "$id"
  prune_upgrades "$id" 0
  rm -f "$HOST_DIR/secrets/$id.env"
  if [ "$never_live" = 1 ]; then
    rm -f "$HOST_DIR/registry/$id.env"
    log "$id: failed create removed (database, role, network, files, routing, secret, registry); the id and host are free again"
    return 0
  fi
  host="$(reg "$id" TENANT_HOST)"
  [ -z "$host" ] || reg_set "$id" HOST_SHA256 "$(sha256 "$host")"
  reg_unset "$id" TENANT_HOST
  reg_unset "$id" TENANT_ORG
  reg_set "$id" STATUS deleted
  reg_set "$id" DELETED_AT "$(now)"
  log "$id: deleted (database, role, network, files, saved upgrade code, routing, secret). Archives remain until retention: local $(cfg BACKUP_KEEP_LOCAL 7) days, off-box per the bucket lifecycle"
}

cmd_host_down() {
  local id
  if [ "${1:-}" = --volumes ]; then
    for id in $(tenant_ids); do tc "$id" down --remove-orphans >/dev/null 2>&1 || true; detach_shared "$id"; done
    sweep_drills
    hc --profile tools down -v --remove-orphans >/dev/null 2>&1 || true
  else
    hc down >/dev/null 2>&1 || true
  fi
}

cmd_logs() { need_tenant "$1"; tc "$1" logs --tail "${2:-100}" kernel; }

# restart <id>: the kernel reads site/ (features, plan) at start
cmd_restart() {
  need_tenant "$1"
  [ "$(reg "$1" STATUS)" = active ] || die "$1 is $(reg "$1" STATUS), not active"
  tc "$1" restart kernel >/dev/null 2>&1
  wait_kernel "$1" || die "$1: kernel did not come back"
  log "$1: restarted"
}

# kernel <id> <rangka args...>: one-off `rangka` command against the tenant's database and bundle, with its pinned
# release (user add, numbering set, plan set, ...). RANGKA_USER_PASSWORD / RANGKA_OWNER_PASSWORD pass through the
# environment when set, never argv.
cmd_kernel() {
  local id="${1:-}" flags=()
  shift || true
  need_tenant "$id"
  case "$(reg "$id" STATUS)" in active|suspended) ;; *) die "$id is $(reg "$id" STATUS)" ;; esac
  [ $# -ge 1 ] || die "usage: tenantctl kernel <id> <rangka args...>"
  case "$1" in serve) die "use resume/restart to run the server" ;; esac
  [ -z "${RANGKA_USER_PASSWORD:-}" ] || flags+=(-e RANGKA_USER_PASSWORD)
  [ -z "${RANGKA_OWNER_PASSWORD:-}" ] || flags+=(-e RANGKA_OWNER_PASSWORD)
  tc "$id" run --rm -T --no-deps ${flags[@]+"${flags[@]}"} kernel "$@"
}

# ---------- main
while [ $# -gt 0 ]; do
  case "$1" in
    --env) ENV_FILE="${2:?}"; shift 2 ;;
    -h|--help) usage ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || usage
cmd="$1"; shift
command -v docker >/dev/null || die "docker not found"
load_config
case "$cmd" in
  create|upgrade|delete|suspend|resume|restart|drill|host-up|host-down) lock ;;
esac
case "$cmd" in
  host-up) host_up ;;
  host-down) cmd_host_down "$@" ;;
  create) cmd_create "$@" ;;
  list) cmd_list ;;
  status) cmd_status "${1:?tenant id}" ;;
  health) cmd_health "$@" ;;
  logs) cmd_logs "${1:?tenant id}" "${2:-100}" ;;
  restart) cmd_restart "${1:?tenant id}" ;;
  kernel) cmd_kernel "$@" ;;
  backup) cmd_backup "${1:-}" ;;
  drill) cmd_drill "$@" ;;
  suspend) cmd_suspend "${1:?tenant id}" ;;
  resume) cmd_resume "${1:?tenant id}" ;;
  upgrade) cmd_upgrade "$@" ;;
  delete) cmd_delete "$@" ;;
  *) usage ;;
esac
