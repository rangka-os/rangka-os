# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.4/model.json
# One outlet a member works at. Rows are written by the kernel from the membership (contract 0055), not edited on the record.
name: user_outlet
is_child: true
fields:
  - {name: outlet, type: link, to: outlet, label: {id: Outlet}, read_only: true, in_list: true}
