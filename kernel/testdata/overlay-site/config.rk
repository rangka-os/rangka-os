# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/config.json
locale: id-ID
currency: IDR
timezone: Asia/Jakarta
tax: {ppn_rate: 12, dpp_ratio: 11/12, pkp: true}
org: {legal_name: PT Kopi Senja Nusantara, npwp: "00.000.000.0-000.001", pkp: true}
numbering:
  sales_invoice: INV-{YYYY}-{#####}
apps: [core, crm, sales]
plan: tumbuh
theme: kopi_senja
layout: crm_first
sso: {domains: [kopisenja.id], required: false}
ai: {enabled: true, auto_apply: never, approvers: [owner, sales_manager]}
orgs:
  pt_alpha: {name: PT Alpha Inspeksi, code: ALP, config: {org: {legal_name: PT Alpha Inspeksi, pkp: true}}}
