{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rangka-os.github.io/rangka-os/schema/0.5/app.json",
  "title": "Rangka app",
  "description": "What a customer installs (apps/<name>/app.rk): the modules it uses, connectors, roles, menu, dashboards, home and onboarding. An app defines no models; make a module instead.",
  "type": "object",
  "required": [
    "name",
    "version",
    "title",
    "modules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "$ref": "model.json#/$defs/name"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "$ref": "model.json#/$defs/label"
    },
    "label": {
      "$ref": "model.json#/$defs/label"
    },
    "summary": {
      "$ref": "model.json#/$defs/label"
    },
    "category": {
      "$ref": "model.json#/$defs/catalogue_category"
    },
    "icon": {
      "$ref": "model.json#/$defs/icon"
    },
    "rangka": {
      "type": "string",
      "description": "kernel version range, e.g. '>=0.5'"
    },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "module → version range (^1.0, >=1.2): the modules this app installs"
    },
    "optional": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "recommends": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "model.json#/$defs/name"
          },
          "flow": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "$ref": "model.json#/$defs/name"
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+\\.[a-z_]+$"
      }
    },
    "menu": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group",
          "items"
        ],
        "properties": {
          "group": {
            "$ref": "model.json#/$defs/label"
          },
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "model.json#/$defs/name"
                },
                {
                  "type": "object",
                  "required": [
                    "label",
                    "items"
                  ],
                  "additionalProperties": false,
                  "description": "A sub-menu (contract 0037): one more level, no deeper",
                  "properties": {
                    "label": {
                      "$ref": "model.json#/$defs/label"
                    },
                    "icon": {
                      "type": "string"
                    },
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 12,
                      "items": {
                        "$ref": "model.json#/$defs/name"
                      }
                    }
                  }
                }
              ]
            }
          },
          "collapsed": {
            "type": "boolean",
            "description": "Starting state of the group before the person folds or opens it (contract 0037); the site layout's nav.side wins"
          }
        },
        "additionalProperties": false
      }
    },
    "dashboards": {
      "type": "array",
      "items": {
        "$ref": "model.json#/$defs/name"
      },
      "description": "Dashboards in dashboards/*.rk, in menu order. The first is the app's home page."
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "model.json#/$defs/name"
        },
        "view": {
          "enum": [
            "list",
            "kanban",
            "calendar",
            "report"
          ]
        },
        "dashboard": {
          "$ref": "model.json#/$defs/name"
        }
      }
    },
    "work": {
      "type": "array",
      "description": "Work screens of the app's modules bound to roles (contract 0030 §3). A screen not named here is not offered; home: true makes it the landing page of those roles.",
      "items": {
        "type": "object",
        "required": [
          "screen"
        ],
        "additionalProperties": false,
        "properties": {
          "screen": {
            "$ref": "model.json#/$defs/name"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "model.json#/$defs/name"
            },
            "description": "Narrows the screen's own roles (default: all of them)"
          },
          "home": {
            "type": "boolean"
          }
        }
      }
    },
    "onboarding": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ask",
          "sets"
        ],
        "additionalProperties": false,
        "properties": {
          "ask": {
            "$ref": "model.json#/$defs/label"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sets": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
