# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: outlet_sales_line
is_child: true
fields:
  - name: item
    type: link
    to: item
    label: {id: Barang}
    required: true
  - name: description
    type: text
    label: {id: Uraian}
    default: item.item_name
  - name: qty
    type: float
    label: {id: Qty}
    required: true
    stock: true
  - name: gross
    type: currency
    label: {id: Penjualan kotor}
    default: round(qty * item.rate)
  - name: discount
    type: currency
    label: {id: Diskon}
    default: '0'
  - name: refund
    type: currency
    label: {id: Retur}
    default: '0'
  - name: net
    type: currency
    label: {id: Penjualan bersih}
    help: {id: 'Kotor dikurangi diskon dan retur (sama dengan Net Sales di Moka)'}
    compute: round(gross - discount - refund)
  - name: cogs
    type: currency
    label: {id: Harga pokok}
    read_only: true
