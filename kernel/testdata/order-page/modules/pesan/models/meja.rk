# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: meja
label: {id: Meja}
naming: MJ-{###}
title_field: nama
fields:
  - {name: nama, type: data, label: {id: Nama meja}, required: true}
  - {name: active, type: check, label: {id: Aktif}, default: 'true'}
permissions:
  - {role: kasir, read: true}
  - {role: kantor, read: true, create: true, write: true}
