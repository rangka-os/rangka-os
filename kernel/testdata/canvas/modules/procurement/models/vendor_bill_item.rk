# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: vendor_bill_item
is_child: true
fields:
  - name: item
    type: link
    to: item
    label: {id: Barang/jasa}
    required: true
  - name: description
    type: text
    label: {id: Uraian}
    default: item.item_name
  - name: qty
    type: float
    label: {id: Qty}
    default: '1'
  - name: uom
    type: link
    to: uom
    label: {id: Satuan}
    default: item.stock_uom
  - name: rate
    type: currency
    label: {id: Harga satuan}
    required: true
  - name: amount
    type: currency
    label: {id: Jumlah}
    compute: round(qty * rate)

  - {name: rate_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Harga (valas)}, default: '0'}
  - {name: amount_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Jumlah (valas)}, compute: "round(qty * rate_fx, 2)"}
