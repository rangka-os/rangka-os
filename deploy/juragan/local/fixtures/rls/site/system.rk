# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/system.json
db: {driver: postgres, url: '${DATABASE_URL}', pool: 10, isolation: shared}
cache: {driver: memory, max_mb: 16}
queue: {driver: postgres, workers: 2, retries: 3, dead_letter_after: 24h}
scheduler: {driver: internal, timezone: Asia/Jakarta}
realtime: {driver: postgres, transports: [sse]}
files: {driver: local, path: ./data/files, max_upload_mb: 5}
search: {driver: postgres, vectors: false}
auth:
  issuer: http://localhost:8080
  session_ttl: 24h
secrets: {driver: env}
audit: {enabled: true, retention_days: 30}
observability: {log_level: info, metrics: false}
