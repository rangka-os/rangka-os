{
  "title": "Tambah tabel Kunjungan Toko",
  "ops": [
    {
      "op": "create",
      "path": "modules/quotation/models/kunjungan_toko.rk",
      "content": "# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json\nname: 'kunjungan_toko'\n"
    },
    {
      "op": "patch",
      "path": "modules/quotation/models/kunjungan_toko.rk",
      "patch": [
        {
          "op": "add",
          "path": "/label",
          "value": {
            "id": "Kunjungan Toko"
          }
        },
        {
          "op": "add",
          "path": "/title_field",
          "value": "tanggal"
