# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/dashboard.json
name: ok_tables
label: {id: Tabel baik}
roles: [owner]
widgets:
  - name: by_customer
    type: table
    label: {id: Per pelanggan}
    model: sales_invoice
    group_by: customer
    sort: -sales
    columns:
      - {name: sales, label: {id: Penjualan}, fn: sum, field: grand_total}
      - {name: count, label: {id: Jumlah}, fn: count}
      - {name: average, label: {id: Rata-rata}, expr: sales / count, format: currency}
    span: 12
  - name: by_status
    type: heatmap
    label: {id: Status per pelanggan}
    model: sales_invoice
    group_by: customer
    series_by: status
    aggregate: count
    span: 12
