# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: stock_negative_alert
label: {id: Peringatan stok minus}
# The kernel passes the stock_move record as `event` (name, outlet, item, qty, balance_qty, negative, ...). It does not
# yet dispatch `<model>.created` events to flows (S8c finding), so head office also sees the "Stok minus" list.
# The two find steps turn the record names into item and outlet names for the message; when a record cannot be found
# (deleted, or outside the actor's scope) the text falls back to the plain names.
on: stock_move.created
if: event.negative == true
steps:
  - {find: item, where: name == event.item, as: it}
  - {find: outlet, where: name == event.outlet, as: ou}
  - notify: head_office
    channel: in_app
    template: {id: 'Stok {it != null ? it.item_name : event.item} di {ou != null ? ou.outlet_name : event.outlet} minus ({event.balance_qty})'}
