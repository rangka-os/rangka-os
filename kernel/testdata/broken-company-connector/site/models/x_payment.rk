# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: x_payment
label: {id: Pembayaran}
title_field: reference
fields:
  - {name: reference, type: data, label: {id: Referensi}, required: true}
  - {name: amount, type: money, currency_field: currency, label: {id: Jumlah}}
  - {name: currency, type: data, label: {id: Mata uang}}
  - {name: rate, type: float, label: {id: Kurs}}
