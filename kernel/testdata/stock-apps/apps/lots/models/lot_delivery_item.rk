# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: lot_delivery_item
is_child: true
fields:
  - {name: item, type: link, to: item, required: true}
  - {name: qty, type: float, required: true}
  - {name: lot, type: link, to: stock_lot}
  - {name: serial_nos, type: text}
