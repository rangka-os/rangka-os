# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: kunjungan
label: {id: Kunjungan}
naming: KNJ-{#####}
fields:
  - {name: customer, type: link, to: pelanggan, label: {id: Pelanggan}, required: true, in_list: true}
  - {name: at, type: datetime, label: {id: Waktu}, default: now(), in_list: true}
  - {name: pos, type: geo, label: {id: Posisi}}
  - {name: photo, type: image, label: {id: Foto}}
  - {name: by, type: data, label: {id: Penagih}}
  - {name: dist_m, type: float, label: {id: Jarak dari titik (m)}, read_only: true, compute: "distance_m(pos, customer.pos)"}
permissions:
  - {role: penagih, read: true, create: true, write: true}
