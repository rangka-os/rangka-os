      ]
    },
    {
      "op": "patch",
      "path": "layouts/utama.rk",
      "patch": [
        {
          "op": "add",
          "path": "/nav/side/-",
          "value": {
            "group": {
              "id": "Tabel baru"
            },
            "items": [
              {
                "to": "model:kunjungan_toko",
