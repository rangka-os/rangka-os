# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/layout.json
# Broken: a sub-menu link to a missing model, phone tabs without tabs, a tab to a missing dashboard
name: kantor
extends: rangka/side-only
nav:
  side:
    - group: {id: Penjualan}
      items:
        - {to: 'model:deal'}
        - label: {id: Data induk}
          items:
            - {to: 'model:pemasok'}
            - label: {id: Terlalu dalam}
              items: [{to: 'model:customer'}]
responsive:
  tablet: laci
  phone: tabs
