{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rangka-os.github.io/rangka-os/schema/0.5/portal.json",
  "title": "Rangka portal page",
  "description": "One customer-facing page of a module, portal/<name>.rk (contract 0073). v1 builds the document type.",
  "type": "object",
  "required": ["type", "model", "label"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "type": {"enum": ["document", "documents", "catalogue", "booking", "intake", "order_page"],
             "description": "Page type (contract 0073 §1); only document is built, the others are reserved"},
    "model": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "label": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 80}},
    "customer": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$",
                 "description": "Link field to the customer; the page shows its title"},
    "amount": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$",
               "description": "Number field shown as the headline amount; 0 or less reads as paid"},
    "due": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Date field shown as the due date"},
    "fields": {"type": "array", "maxItems": 20, "uniqueItems": true,
               "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
               "description": "Fields shown to the customer (contract 0073 §2); nothing else is"},
    "lines": {
      "type": "object",
      "required": ["field", "columns"],
      "additionalProperties": false,
      "properties": {
        "field": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "A table field of the model"},
        "columns": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
                    "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
      }
    },
    "print": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "A print format of the model"},
    "payment": {
      "type": "object",
      "required": ["model", "link"],
      "additionalProperties": false,
      "properties": {
        "model": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "link": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$",
                 "description": "Link field of the payment model that names the document"},
        "fields": {"type": "array", "maxItems": 12, "uniqueItems": true,
                   "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "qris": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$",
                 "description": "Text field holding a static QRIS string, shown as a QR image"},
        "qris_label": {"type": "array", "maxItems": 3, "uniqueItems": true,
                       "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
      }
    },
    "share": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "description": "Roles besides owner that make and revoke links"},
    "lifetime_days": {"type": "integer", "minimum": 1, "maximum": 90, "description": "Link lifetime; default 30"}
  }
}
