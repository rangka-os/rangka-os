# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.4/model.json
name: quotation
label: {id: Penawaran harga}
naming: QTN-{YYYY}-{#####}
title_field: customer
fields:
  - {name: revision, type: int, label: {id: Revisi}}
  - {name: quotation_date, type: date, label: {id: Tanggal penawaran}, required: true, in_list: true}
  - {name: valid_until, type: date, label: {id: Berlaku sampai}}
  - {name: customer, type: link, to: customer, label: {id: Pelanggan}, required: true, in_list: true}
  - {name: contact_person, type: data, label: {id: Kontak}}
  - {name: subject, type: data, label: {id: Perihal}}
  - {name: items, type: table, of: quotation_item, label: {id: Barang dan jasa}}
  - {name: subtotal, type: currency, label: {id: Subtotal}}
  - {name: discount_amount, type: currency, label: {id: Diskon}}
  - {name: dpp, type: currency, label: {id: DPP nilai lain}}
  - {name: ppn, type: currency, label: {id: PPN}}
  - {name: grand_total, type: currency, label: {id: Total}, in_list: true}
  - {name: payment_terms, type: text, label: {id: Syarat pembayaran}}
  - {name: delivery_terms, type: text, label: {id: Waktu pelaksanaan}}
  - {name: notes, type: text, label: {id: Catatan}}
