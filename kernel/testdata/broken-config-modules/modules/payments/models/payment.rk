# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: payment
label: {id: Pembayaran}
naming: PAY-{#####}
title_field: invoice
fields:
  - {name: invoice, type: link, to: invoice, label: {id: Tagihan}, required: true}
  - {name: paid_on, type: date, label: {id: Tanggal bayar}}
permissions:
  - {role: sales_rep, read: true, write: true, create: true}
