# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/connector.json
name: x_payloop
label: {id: Contoh perulangan}
summary: {id: Contoh connector untuk uji for_each pada money_unflagged.}
version: 0.1.0
hosts: [api.example.com]
experimental:
  source:
    kind: docs
    url: https://api.example.com/docs
auth:
  type: token
  fields:
    - name: access_token
      label: {id: Access token}
      secret: true
triggers:
  - name: changed
    via: webhook
actions:
  - name: list
    label: {id: Daftar}
    request:
      method: GET
      url: https://api.example.com/items
      headers: {Authorization: 'Bearer {auth.access_token}'}
