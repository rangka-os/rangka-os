# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/process.json
name: bad_starter
stages:
  - {name: no_model, starter: [{customer_name: Toko Maju}]}
  - {name: customer, model: customer, starter: [{customer_nam: Toko Maju, city: Bandung}]}
  - {name: invoice, model: sales_invoice, starter: [{grand_total: "50000"}]}
