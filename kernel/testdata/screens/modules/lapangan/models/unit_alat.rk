# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: unit_alat
label: {id: Unit alat}
naming: UNT-{###}
title_field: title
fields:
  - {name: code, type: data, label: {id: Kode unit}, required: true, unique: true, in_list: true}
  - {name: title, type: data, label: {id: Alat}, required: true, in_list: true}
permissions:
  - {role: petugas, read: true}
