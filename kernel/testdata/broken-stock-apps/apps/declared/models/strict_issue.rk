# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
# an issue that refuses to leave the outlet below zero
name: strict_issue
is_submittable: true
naming: SI-{#####}
on_cancel: [stock.reverse_moves]
stock:
  negative: refuse
  cogs_total: total
  moves:
    - {lines: items, out: outlet, reason: adjustment}
fields:
  - {name: outlet, type: link, to: outlet, required: true}
  - {name: issue_date, type: date, required: true}
  - {name: total, type: currency, read_only: true}
  - {name: items, type: table, of: adj_declared_item, min_rows: 1}
