# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: purchase_request_item
is_child: true
fields:
  - name: item
    type: link
    to: item
    label: {id: Barang}
    required: true
  - name: description
    type: text
    label: {id: Uraian}
    default: item.item_name
  - name: qty
    type: float
    label: {id: Qty}
    required: true
  - name: uom
    type: link
    to: uom
    label: {id: Satuan}
    default: "packing != '' ? packing.uom : item.stock_uom"
  - name: packing
    type: link
    to: uom_conversion
    label: {id: Kemasan}
    help: {id: 'Isi bila qty dalam kemasan (mis. karung); faktornya menentukan qty stok'}
  - name: est_rate
    type: currency
    label: {id: Perkiraan harga}
    default: item.standard_cost
  - name: amount
    type: currency
    label: {id: Jumlah}
    compute: round(qty * est_rate)
