# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.4/overlay.json
model: sales_invoice
fields:
  - {name: x_po_number, type: data, label: {id: Nomor PO}}
  - {name: po_ref, type: data}
  - {name: x_region, type: link, to: regionn}
  - {name: x_due2, type: date, default: posting_date + duration(custmer.payment_days)}
  - {name: x_a, type: int, compute: x_b + 1}
  - {name: x_b, type: int, compute: x_a + 1}
  - {name: x_po_number, type: data}
rules:
  - name: po_needed
    on: submit
    check: x_po_number != '' || notes2 != ''
    message: {id: Isi nomor PO}
approvals:
  - {name: big, on: ship, when: "grand_totl > 1", approvers: [sales_manager]}
  - {name: a, on: submit, approvers: [ghost_role]}
  - {name: big, on: submit, approvers: [sales_manager]}
views:
  form:
    layout:
      - section: {id: Utama}
        fields: [customer, ghost_field]
    add:
      - {field: x_po_number, after: customer}
      - {field: x_missing}
      - {field: x_po_number, after: outlet}
  kanban:
    columns: [a]
  list:
    columns: [name, nope_col]
    add:
      - {field: x_po_number, after: nope}
      - {field: x_po_number, after: status}
