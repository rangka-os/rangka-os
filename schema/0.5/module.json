{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rangka-os.github.io/rangka-os/schema/0.5/module.json",
  "title": "Rangka module",
  "description": "A reusable business unit (modules/<name>/module.rk): models, rules, flows and roles. It requires other modules; menus, dashboards, home and onboarding belong to an app.",
  "type": "object",
  "required": [
    "name",
    "version",
    "title"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "$ref": "model.json#/$defs/name"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "$ref": "model.json#/$defs/label"
    },
    "summary": {
      "$ref": "model.json#/$defs/label",
      "description": "One sentence in plain words for the catalogue (contract 0036)"
    },
    "category": {
      "$ref": "model.json#/$defs/catalogue_category"
    },
    "icon": {
      "$ref": "model.json#/$defs/icon"
    },
    "requires": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "module → version range (^1.0, >=1.2); rangka: '>=0.5' pins the kernel"
    },
    "optional": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+\\.[a-z_]+$"
      }
    },
    "notices": {
      "type": "array",
      "description": "Notices this module raises (contract 0066 §1.1): kind app.<module>.<name>. A notify step names one with notice:.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "label": {
            "$ref": "model.json#/$defs/label",
            "description": "What the notice is called (its title when a step gives none); at most 80 characters"
          },
          "description": {
            "$ref": "model.json#/$defs/description"
          },
          "severity": {
            "enum": [
              "info",
              "warn",
              "high"
            ],
            "default": "info"
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "description": "Roles told; owner is always a valid role"
          },
          "can": {
            "type": "object",
            "required": [
              "model",
              "action"
            ],
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string"
              },
              "action": {
                "enum": [
                  "read",
                  "create",
                  "write",
                  "delete",
                  "submit",
                  "cancel",
                  "amend",
                  "export",
                  "import",
                  "print"
                ]
              }
            },
            "description": "Only roles that hold this permission (with to: of those roles, without to: every role that holds it)"
          },
          "link": {
            "enum": [
              "record",
              "approvals",
              "none"
            ],
            "description": "Where the notice leads: the step's record (default when the step names one), the approvals inbox, or nowhere"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
