# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.4/model.json
name: purchase_order
label: {id: Pesanan pembelian}
naming: PO-{YYYY}-{#####}
title_field: vendor
fields:
  - {name: order_date, type: date, label: {id: Tanggal pesanan}, required: true, in_list: true}
  - {name: delivery_date, type: date, label: {id: Tanggal kirim}}
  - {name: vendor, type: link, to: vendor, label: {id: Pemasok}, required: true, in_list: true}
  - {name: ship_to, type: text, label: {id: Kirim ke}}
  - {name: items, type: table, of: purchase_order_item, label: {id: Barang}}
  - {name: subtotal, type: currency, label: {id: Subtotal}}
  - {name: ppn, type: currency, label: {id: PPN}}
  - {name: grand_total, type: currency, label: {id: Total}, in_list: true}
  - {name: payment_terms, type: data, label: {id: Syarat pembayaran}}
  - {name: notes, type: text, label: {id: Catatan}}
