# Copy to .env (never commit it) and fill in. Compose refuses to start when a required key is empty.

# Release image: pinned tag, never "latest", 0.5.0-alpha.3 or later (backups tolerate a missing connectors/ or
# modules/). RANGKA_IMAGE overrides the whole reference.
RANGKA_TAG=0.5.0-alpha.3
#RANGKA_IMAGE=ghcr.io/rangka-os/rangka:${RANGKA_TAG}

# Absolute path of the folder holding the pilot project folders jasa/ and fnb/
# (each has apps/, modules/, site/, fixtures/, data/, optional connectors/; mounted at /srv, writable by uid 65532).
PILOTS_DIR=/opt/juragan/pilots

# The kernels run with RANGKA_ENV=production and RANGKA_BACKUP_DIR=/srv/backups (compose.yaml): the kernel takes
# a backup there before every migration. Create <PILOTS_DIR>/jasa/backups and fnb/backups, owned by uid 65532.
# The nightly archive does not include that folder.

# Public hostnames (placeholders until DNS exists) and the organisation id of each pilot.
JASA_HOST=jasa.juragan.ai
FNB_HOST=fnb.juragan.ai
JASA_ORG=jasa
FNB_ORG=fnb

# Caddy TLS: the ACME contact email in production, `internal` for a local self-signed CA.
CADDY_TLS=

# Database secrets (generate with: openssl rand -hex 24)
POSTGRES_PASSWORD=
JASA_DB_PASSWORD=
FNB_DB_PASSWORD=

# Only for `docker compose run --rm jasa seed` (first owner account); leave blank afterwards.
RANGKA_OWNER_EMAIL=
RANGKA_OWNER_PASSWORD=

# Nightly backup (docker compose run --rm backup all; see systemd/ and RUNBOOK.md).
# Folder for local archives (kept BACKUP_KEEP_LOCAL days). Keep it outside the git clone.
BACKUP_DIR=/opt/juragan/backups
BACKUP_KEEP_LOCAL=7
# Off-box bucket and the age public key (age1...) archives are encrypted to. The private key is NOT
# kept on this machine. BACKUP_ALLOW_PLAINTEXT=1 skips encryption: local debugging only.
BACKUP_BUCKET=
BACKUP_AGE_RECIPIENT=
#BACKUP_ALLOW_PLAINTEXT=0
# How the database is dumped: pg_dump (default), rangka (`rangka backup`, fails when the binary lacks it) or auto
# (rangka when available). Switch to rangka only after a manual backup and a restore drill passed on an S1 release.
#BACKUP_METHOD=pg_dump
# Optional dead-man's-switch URL, pinged only after a fully successful run.
BACKUP_PING_URL=
# Upload tuning (rclone): whole-run retries, low-level retries, connect timeout.
#BACKUP_RCLONE_RETRIES=3
#BACKUP_RCLONE_LOW_LEVEL_RETRIES=10
#BACKUP_RCLONE_CONTIMEOUT=30s
# Off-box S3-compatible storage (rclone remote "offbox"). The key should be allowed to write, not delete.
RCLONE_CONFIG_OFFBOX_TYPE=s3
RCLONE_CONFIG_OFFBOX_PROVIDER=
RCLONE_CONFIG_OFFBOX_REGION=
# Blank for AWS S3; the service URL for other providers.
RCLONE_CONFIG_OFFBOX_ENDPOINT=
RCLONE_CONFIG_OFFBOX_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFBOX_SECRET_ACCESS_KEY=
