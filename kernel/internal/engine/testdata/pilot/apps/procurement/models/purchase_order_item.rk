# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.4/model.json
name: purchase_order_item
is_child: true
fields:
  - {name: item, type: link, to: item, required: true}
  - {name: qty, type: float, required: true}
  - {name: uom, type: link, to: uom, default: item.stock_uom}
  - {name: packing, type: link, to: uom_conversion}
  - {name: stock_qty, type: float, compute: "packing == '' ? qty : qty * packing.factor"}
  - {name: rate, type: currency, required: true}
  - {name: amount, type: currency, compute: round(qty * rate)}
  - {name: received_qty, type: float, read_only: true}
