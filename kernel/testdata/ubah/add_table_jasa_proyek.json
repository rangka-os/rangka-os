                  "id": "CRM"
                },
                "items": [
                  {
                    "to": "model:deal"
                  },
                  {
                    "to": "model:lead"
                  },
                  {
                    "to": "model:activity"
                  }
                ]
              },
              {
                "group": {
                  "id": "Penjualan"
                },
                "items": [
                  {
                    "to": "model:sales_invoice"
                  }
                ]
              },
              {
                "group": {
                  "id": "Penjualan"
                },
                "items": [
                  {
                    "to": "model:quotation"
                  },
                  {
                    "to": "model:customer_order"
                  },
                  {
                    "to": "model:sales_invoice"
                  }
                ]
              },
              {
                "group": {
                  "id": "Proyek"
                },
                "items": [
                  {
                    "to": "model:project"
                  }
                ]
              }
            ]
          }
