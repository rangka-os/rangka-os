# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.4/model.json
name: payment_allocation
is_child: true
fields:
  - {name: sales_invoice, type: link, to: sales_invoice}
  - {name: vendor_bill, type: link, to: vendor_bill}
  - {name: amount, type: currency, required: true}
  - {name: withheld, type: currency, default: '0'}
  - {name: applied_idr, type: int, read_only: true}
