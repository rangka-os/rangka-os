# yaml-language-server: $schema=https://rangka.dev/schema/0.4/system.json
# Layer 2: one file per installation. App files say what they need; this file decides how.
db: {driver: postgres, url: '${DATABASE_URL}', pool: 10, isolation: shared}
cache: {driver: memory, max_mb: 64}
queue: {driver: postgres, workers: 4, retries: 3, dead_letter_after: 24h}
scheduler: {driver: internal, timezone: Asia/Jakarta}
realtime: {driver: postgres, transports: [sse]}
files: {driver: local, path: ./data/files, max_upload_mb: 25}
search: {driver: postgres, vectors: false}
notify:
  email: {driver: log, from: Kopi Senja <halo@kopisenja.id>}
  push: {enabled: false, driver: log}
  whatsapp: {enabled: true, connector: whatsapp_business}
auth:
  issuer: http://localhost:8080
  session_ttl: 24h
  two_factor: owners
  clients:
    - id: omilo
      label: Omilo
      redirect_uris: [http://localhost:3000/auth/callback]
      public: true
      scopes: [openid, profile, email, rangka.mcp]
secrets: {driver: env}
audit: {enabled: true, retention_days: 365}
observability: {log_level: info, metrics: true}
