# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/screen.json
# contract 0069: checkout and line slots that are not allowed
name: kasir_e
type: counter
label: {id: Kasir E}
roles: [staf]
counter:
  catalogue:
    model: catatan_harian
    price: ghost
  document:
    model: jam_kerja
    lines: breaks
    line: {item: minutes, qty: minutes, flag: minutes, amount: ghost}
    checkout: [total, breaks, ghost, note, {field: staff, filter: "staff == 'x'"}, {field: date, filter: "(x"}]
