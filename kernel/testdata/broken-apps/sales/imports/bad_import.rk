# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/import.json
name: bad_import
model: sales_invoice
per: outlet
key: [posting_date]
map:
  nope: Kolom
  customer: {value: "=lower(name", match: nope}
  notes: {value: Catatan, match: id}
lines:
  field: notes
  map:
    item: SKU
