# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: stock_adjustment
label: {id: Penyesuaian stok, en: Stock adjustment}
icon: stock
is_submittable: true
naming: ADJ-{YYYY}-{#####}
on_submit: [stock.post_moves]
on_cancel: [stock.reverse_moves]
permissions:
  - {role: head_office, read: true, create: true, write: true, delete: true, submit: true, cancel: true, amend: true, export: true, print: true}
  - {role: outlet_staff, read: true, create: true, write: true, submit: true}
fields:
  - name: outlet
    type: link
    to: outlet
    label: {id: Outlet}
    required: true
    in_list: true
  - name: adjustment_date
    type: date
    label: {id: Tanggal}
    default: today()
    required: true
    in_list: true
  - name: reason
    type: select
    label: {id: Alasan}
    required: true
    in_list: true
    chip: true
    options:
      - {value: waste, label: {id: Terbuang}}
      - {value: damage, label: {id: Rusak}}
      - {value: expired, label: {id: Kedaluwarsa}}
      - {value: other, label: {id: Lainnya}}
  - name: items
    type: table
    of: stock_adjustment_item
    label: {id: Barang}
    min_rows: 1
  - name: notes
    type: text
    label: {id: Catatan}
rules:
  - name: qty_positive
    on: save
    check: "items.map(i, i.qty <= 0 ? 1 : 0).sum() == 0"
    message: {id: Jumlah barang harus lebih dari 0}
views:
  list:
    columns: [name, outlet, adjustment_date, reason, status]
    sort: -adjustment_date
  form:
    layout:
      - section: {id: Penyesuaian}
        columns:
          - [outlet, adjustment_date, reason]
      - section: {id: Barang}
        fields: [items]
      - section: {id: Catatan}
        fields: [notes]
