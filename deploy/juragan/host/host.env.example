# Tenant host settings. Copy to .env (never commit it), fill in, chmod 600. Read by tenantctl and compose.

# Where tenants, registry, secrets, Caddy sites and local backups live (absolute; outside the git clone).
HOST_DIR=/opt/juragan/host
# Compose project and network of the shared services; tenants are projects juragan-t-<id> on that network.
HOST_PROJECT=juragan-host
HOST_NETWORK=juragan-tenants

# Default release for new tenants (a GitHub Release tag, never "latest"); each tenant keeps its own pin
# (tenantctl upgrade moves it). The backup image is built from this release too.
RANGKA_TAG=v0.5.0-alpha.8
# pdf (Chromium for PDF print, about 1 GB image) or slim (no PDF, 40 MB).
KERNEL_TARGET=pdf
# Per kernel memory cap and concurrent PDF renders (each render 100-200 MB).
KERNEL_MEM_LIMIT=768m
RANGKA_PDF_CONCURRENCY=1

# Tenants get <id>.<TENANT_DOMAIN> unless created with --host.
TENANT_DOMAIN=juragan.ai
# acme (public certificates, needs DNS pointing here and 80/443 open), internal (self-signed CA) or off (plain HTTP,
# local tests only).
TLS_MODE=acme
ACME_EMAIL=
BIND_ADDR=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# Postgres superuser (openssl rand -hex 24). Tenant roles get their own generated passwords (secrets/<id>.env).
POSTGRES_PASSWORD=
#POSTGRES_IMAGE=postgres:16-alpine

# Assistant (rangka-ai sidecar), optional: URL reachable from the tenant network, and its shared secret.
RANGKA_AI_URL=
RANGKA_AI_SECRET=

# Nightly backup (tenantctl backup all; see systemd/). Same meaning as the pilot deploy's ../.env.example.
BACKUP_KEEP_LOCAL=7
BACKUP_BUCKET=
BACKUP_AGE_RECIPIENT=
#BACKUP_ALLOW_PLAINTEXT=0
#BACKUP_METHOD=pg_dump
BACKUP_PING_URL=
RCLONE_CONFIG_OFFBOX_TYPE=s3
RCLONE_CONFIG_OFFBOX_PROVIDER=
RCLONE_CONFIG_OFFBOX_REGION=
RCLONE_CONFIG_OFFBOX_ENDPOINT=
RCLONE_CONFIG_OFFBOX_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFBOX_SECRET_ACCESS_KEY=
# rclone type local only (tests, a mounted disk): the folder mounted at /offbox; then BACKUP_BUCKET=/offbox/<name>.
#OFFBOX_LOCAL_DIR=

# tenantctl health: alert thresholds and a dead man's switch (healthchecks.io; /fail is pinged on a problem).
HEALTH_BACKUP_MAX_AGE_HOURS=26
HEALTH_DISK_MAX_PCT=85
HEALTH_PING_URL=
