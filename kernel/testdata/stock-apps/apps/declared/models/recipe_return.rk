# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
# a cashier refund whose goods go back (contract 0022): through the recipe, at the cost the sale took them out
name: recipe_return
is_submittable: true
naming: RRT-{#####}
on_submit: [stock.post_moves]
on_cancel: [stock.reverse_moves]
stock:
  date: return_date
  moves:
    - {lines: items, in: outlet, explode: recipe, if: "line.condition == 'good'", reason: return_in, cost: {source: sale}}
    - {lines: items, in: outlet, explode: recipe, if: "line.condition == 'damaged'", reason: return_in}
fields:
  - {name: sale, type: link, to: sales_declared}
  - {name: outlet, type: link, to: outlet, required: true}
  - {name: return_date, type: date, required: true}
  - {name: items, type: table, of: sales_return_item, min_rows: 1}
