# yaml-language-server: $schema=https://rangka.dev/schema/0.4/model.json
lit: |
  line one
    indented
  line three

keep: |+
  a

strip: >-
  folded
  text here

  new para
next: plain value
  continued here
seq:
- a
- b: 1
  c: [1, 2.5, "x\ty", 'it''s']
-
  - nested
  - - deeper
empty:
nulls: [~, null, , ]
flow: {a: 1, b: {c: d}, e: [f, g], h: 'dashboard:crm', i: http://x.y/z}
multi: [
  one, # comment
  two
]
quoted: "a \"b\" é
  folded"
sq: 'one

  two'
bools: [true, False, TRUE]
nums: [0, -1, +3, 0x1F, 1.5, .5, 1e3, .inf, -.Inf, .nan]
"quoted key": 1
'single key': {x: y}
colon: a:b
hash: a#b # comment
deep:
  - name: x
    sub:
      - 1
      - 2
  - name: y
