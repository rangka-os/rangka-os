# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: stock_transfer_item
is_child: true
fields:
  - name: item
    type: link
    to: item
    label: {id: Barang}
    required: true
  - name: description
    type: text
    label: {id: Uraian}
    default: item.item_name
  - name: qty
    type: float
    label: {id: Qty}
    required: true
    stock: true
  - name: uom
    type: link
    to: uom
    label: {id: Satuan}
    default: "packing != '' ? packing.uom : item.stock_uom"
  - name: packing
    type: link
    to: uom_conversion
    label: {id: Kemasan}
    help: {id: 'Isi bila qty dalam kemasan (mis. karung); faktornya menentukan qty stok'}
  - name: stock_qty
    type: float
    label: {id: Qty stok}
    compute: "packing == '' ? qty : qty * packing.factor"
  - {name: unit_cost, type: currency, read_only: true, label: {id: Biaya per satuan}, help: {id: 'Diisi saat transfer dikirim: rata-rata outlet asal'}}
  - {name: received_qty, type: float, read_only: true, label: {id: Qty diterima}}
