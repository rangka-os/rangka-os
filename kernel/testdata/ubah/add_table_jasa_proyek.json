                  },
                  "fields": [
                    "tanggal"
                  ]
                }
              ]
            }
          }
        },
        {
          "op": "add",
          "path": "/permissions",
          "value": [
            {
              "role": "sales_manager",
              "read": true,
              "create": true,
              "write": true
            }
          ]
        }
      ]
    },
    {
      "op": "create",
      "path": "layouts/utama.rk",
      "content": "# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/layout.json\nname: 'utama'\n"
    },
    {
      "op": "patch",
