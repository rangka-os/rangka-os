# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/connector.json
name: x_pay
label: {id: Contoh pembayaran}
summary: {id: Contoh connector untuk uji kode money_unflagged.}
version: 0.1.0
hosts: [api.example.com]
experimental:
  source:
    kind: docs
    url: https://api.example.com/docs
auth:
  type: token
  fields:
    - name: access_token
      label: {id: Access token}
      secret: true
triggers:
  - name: paid
    via: webhook
actions:
  - name: charge
    label: {id: Tagih}
    request:
      method: POST
      url: https://api.example.com/charge
      headers: {Authorization: 'Bearer {auth.access_token}'}
