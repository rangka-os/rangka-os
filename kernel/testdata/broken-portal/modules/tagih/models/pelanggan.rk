# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: pelanggan
label: {id: Pelanggan}
naming: PLG-{####}
title_field: title
fields:
  - {name: title, type: data, label: {id: Nama}, required: true, in_list: true}
  - {name: phone, type: phone, label: {id: Telepon}}
permissions:
  - {role: kasir, read: true, create: true}
  - {role: keuangan, read: true, create: true}
