# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: catatan_harian
label: {id: Catatan harian}
naming: CAT-{#####}
fields:
  - {name: text, type: text, label: {id: Catatan}, required: true}
  - {name: score, type: int, label: {id: Nilai}, set_once: true}
  - {name: seen_at, type: datetime, label: {id: Dibaca}, set_once: true}
permissions:
  - {role: staf, read: true, create: true}
