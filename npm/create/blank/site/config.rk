# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/config.json
# {{NAME}}: company settings. Apps listed here are installed; theme and layout pick files in themes/ and layouts/.
locale: id-ID
currency: IDR
timezone: Asia/Jakarta
tax: {ppn_rate: 12, dpp_ratio: 11/12, pkp: false}
numbering:
  sales_invoice: INV-{YYYY}-{#####}
apps: [core, crm, sales]
plan: tumbuh
theme: main
layout: main
ai: {enabled: true, auto_apply: never, approvers: [owner]}
