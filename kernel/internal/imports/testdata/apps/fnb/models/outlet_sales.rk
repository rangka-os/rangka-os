# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.4/model.json
name: outlet_sales
label: {id: Penjualan outlet}
naming: OS-{YYYY}-{####}
title_field: date
fields:
  - name: date
    type: date
    label: {id: Tanggal}
    required: true
  - name: outlet
    type: link
    to: outlet
    label: {id: Outlet}
  - name: note
    type: data
    label: {id: Catatan}
  - name: lines
    type: table
    of: outlet_sales_line
    label: {id: Baris}
