# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: pesanan_baris
is_child: true
fields:
  - {name: menu, type: link, to: menu, label: {id: Menu}, required: true}
  - {name: qty, type: int, label: {id: Qty}, default: '1'}
  - {name: catatan, type: data, label: {id: Catatan}}
  - {name: harga, type: currency, label: {id: Harga}, compute: menu.harga}
  - {name: jumlah, type: currency, label: {id: Jumlah}, compute: qty * harga}
