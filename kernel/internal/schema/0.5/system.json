{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rangka-os.github.io/rangka-os/schema/0.5/system.json",
  "title": "Rangka system",
  "description": "Layer 2: which backend capabilities are on and which driver serves each. One file per installation: system.rk. App files only say what they need (realtime: true, schedule:, queue:, cache:); this file decides how.",
  "type": "object",
  "required": [
    "db"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "db": {
      "type": "object",
      "additionalProperties": false,
      "description": "Primary database. Always on.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "driver": {
          "enum": [
            "postgres"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[^$].*)$",
          "description": "A literal or ${ENV_VAR}. Secrets must use ${…}; the validator refuses literal passwords and keys."
        },
        "pool": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 10
        },
        "isolation": {
          "enum": [
            "shared",
            "schema",
            "database"
          ],
          "default": "shared",
          "description": "shared tables + RLS for small orgs; own schema or database for large ones"
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read cache for views, dashboards, permission checks.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "driver": {
          "enum": [
            "memory",
            "valkey"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[^$].*)$",
          "description": "A literal or ${ENV_VAR}. Secrets must use ${…}; the validator refuses literal passwords and keys."
        },
        "fallback": {
          "enum": [
            "memory",
            "none"
          ],
          "default": "memory"
        },
        "max_mb": {
          "type": "integer",
          "minimum": 8
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "description": "Background jobs: actions with queue:, outbound webhooks, connector calls, emails.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "driver": {
          "enum": [
            "postgres",
            "valkey"
          ]
        },
        "workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256,
          "default": 4
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25,
          "default": 3
        },
        "dead_letter_after": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h|d)$"
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cron-style schedules from flows and automations; runs as queue jobs.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "driver": {
          "enum": [
            "internal"
          ]
        },
        "timezone": {
          "type": "string",
          "default": "Asia/Jakarta"
        },
        "leader_lock": {
          "type": "boolean",
          "default": true
        },
        "stagger_s": {
          "type": "integer",
          "minimum": 0,
          "default": 300,
          "description": "On a host with several organisations, spread each scheduled slot over this many seconds (a fixed offset per organisation, below the schedule's own interval and before the end of the day). 0 runs every organisation at the slot."
        }
      }
    },
    "realtime": {
      "type": "object",
      "additionalProperties": false,
      "description": "Live updates to open screens. Postgres LISTEN/NOTIFY for one node, Valkey pub/sub for many.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "driver": {
          "enum": [
            "postgres",
            "valkey"
          ]
        },
        "transports": {
          "type": "array",
          "items": {
            "enum": [
              "sse",
              "websocket"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "default": [
            "sse"
          ]
        },
        "max_connections": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "description": "Attachments, images, exports.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "driver": {
          "enum": [
            "local",
            "s3"
          ]
        },
        "path": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[^$].*)$",
          "description": "A literal or ${ENV_VAR}. Secrets must use ${…}; the validator refuses literal passwords and keys."
        },
        "access_key": {
          "type": "string",
          "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[^$].*)$",
          "description": "A literal or ${ENV_VAR}. Secrets must use ${…}; the validator refuses literal passwords and keys."
        },
        "secret_key": {
          "type": "string",
          "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[^$].*)$",
          "description": "A literal or ${ENV_VAR}. Secrets must use ${…}; the validator refuses literal passwords and keys."
        },
        "max_upload_mb": {
          "type": "integer",
          "minimum": 1,
          "default": 25
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "description": "Global search (⌘K) and record search.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "driver": {
          "enum": [
            "postgres",
            "opensearch"
          ]
        },
        "vectors": {
          "type": "boolean",
          "default": false,
          "description": "pgvector embeddings for semantic search"
        }
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "description": "Delivery channels. Drivers, not connectors.",
      "properties": {
        "email": {
          "type": "object",
          "additionalProperties": false,
          "description": "",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "driver": {
              "enum": [
                "smtp",
                "log"
              ]
            },
            "host": {
              "type": "string",
              "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[^$].*)$",
              "description": "A literal or ${ENV_VAR}. Secrets must use ${…}; the validator refuses literal passwords and keys."
            },
            "port": {
              "type": "integer"
            },
            "username": {
              "type": "string",
              "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[^$].*)$",
              "description": "A literal or ${ENV_VAR}. Secrets must use ${…}; the validator refuses literal passwords and keys."
            },
            "password": {
              "type": "string",
              "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[^$].*)$",
              "description": "A literal or ${ENV_VAR}. Secrets must use ${…}; the validator refuses literal passwords and keys."
            },
            "from": {
              "type": "string"
            }
          }
        },
        "push": {
          "type": "object",
          "additionalProperties": false,
          "description": "",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "driver": {
              "enum": [
                "fcm",
                "log"
              ]
            },
            "project": {
              "type": "string",
              "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[^$].*)$",
              "description": "A literal or ${ENV_VAR}. Secrets must use ${…}; the validator refuses literal passwords and keys."
            },
            "credentials": {
              "type": "string",
              "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[^$].*)$",
              "description": "A literal or ${ENV_VAR}. Secrets must use ${…}; the validator refuses literal passwords and keys."
            }
          }
        },
        "sms": {
          "type": "object",
          "additionalProperties": false,
          "description": "",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "driver": {
              "enum": [
                "log",
                "twilio",
                "zenziva"
              ]
            },
            "api_key": {
              "type": "string",
              "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[^$].*)$",
              "description": "A literal or ${ENV_VAR}. Secrets must use ${…}; the validator refuses literal passwords and keys."
            }
          }
        },
        "whatsapp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "connector": {
              "type": "string",
              "description": "Uses an installed connector, e.g. whatsapp_business"
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "description": "Rangka ID, built into the kernel: password, passkeys, sessions, API tokens, and an OIDC provider for Omilo and other apps.",
      "properties": {
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "session_ttl": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h|d)$"
        },
        "password": {
          "oneOf": [{"type": "boolean"}, {"const": "owners"}],
          "default": true,
          "description": "true: everyone signs in with a password. false: nobody does. \"owners\": only members with role owner (contract 0042 §6)."
        },
        "team": {
          "enum": ["host", "kernel"],
          "default": "kernel",
          "description": "Who manages the team. kernel: owners manage members in Pengaturan → Tim (/api/v1/team). host: the hosting side (Rangka Cloud) does, and /api/v1/team writes answer 403 team_managed_by_host (contract 0056 §5)."
        },
        "passkeys": {
          "type": "boolean",
          "default": true
        },
        "two_factor": {
          "enum": [
            "off",
            "optional",
            "owners",
            "everyone"
          ],
          "default": "owners"
        },
        "upstream": {
          "type": "array",
          "description": "Sign in with an external IdP (per organisation domain routing lives in config.rk).",
          "items": {
            "type": "object",
            "required": [
              "id",
              "issuer",
              "client_id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "model.json#/$defs/name"
              },
              "label": {
                "type": "string"
              },
              "issuer": {
                "type": "string",
                "format": "uri"
              },
              "client_id": {
                "type": "string",
                "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[^$].*)$",
                "description": "A literal or ${ENV_VAR}. Secrets must use ${…}; the validator refuses literal passwords and keys."
              },
              "client_secret": {
                "type": "string",
                "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[^$].*)$",
                "description": "A literal or ${ENV_VAR}. Secrets must use ${…}; the validator refuses literal passwords and keys."
              }
            }
          }
        },
        "clients": {
          "type": "array",
          "description": "Apps that sign in with Rangka ID (SSO): Omilo, other Rangka installs, partner tools.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "redirect_uris"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "model.json#/$defs/name"
              },
              "label": {
                "type": "string"
              },
              "redirect_uris": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "minItems": 1
              },
              "secret": {
                "type": "string",
                "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[^$].*)$",
                "description": "A literal or ${ENV_VAR}. Secrets must use ${…}; the validator refuses literal passwords and keys."
              },
              "public": {
                "type": "boolean",
                "default": false,
                "description": "Public clients use PKCE and no secret"
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where connector secrets and ${VARS} resolve from (contract 0017). env, file and vault are read only; db keeps per-org values set through the write-only API, encrypted with RANGKA_MASTER_KEY.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "driver": {
          "enum": [
            "env",
            "file",
            "vault",
            "db"
          ]
        },
        "path": {
          "type": "string",
          "description": "file: the directory with one file per ${VAR}; vault: the key path"
        }
      }
    },
    "connector_auth": {
      "type": "object",
      "description": "Binds connector auth fields for the env, file and vault drivers (contract 0017 §2): connector → field → ${VAR}. A secret field must be a ${VAR} reference. orgs.<org> overrides the site's bindings for one organisation.",
      "properties": {
        "orgs": {
          "type": "object",
          "description": "Per-org bindings: org → connector → field → value",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/auth_binding"
            }
          }
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/auth_binding"
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "retention_days": {
          "type": "integer",
          "minimum": 30,
          "default": 365
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "otlp_endpoint": {
          "type": "string",
          "pattern": "^(\\$\\{[A-Z][A-Z0-9_]*\\}|[^$].*)$",
          "description": "A literal or ${ENV_VAR}. Secrets must use ${…}; the validator refuses literal passwords and keys."
        },
        "log_level": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info"
        },
        "metrics": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "maps": {
      "type": "object",
      "additionalProperties": false,
      "description": "Maps (contract 0072): the tile source the browser draws, and the geocoder the kernel calls on the browser's behalf. Both are configuration, not code. Without this block the kernel uses OpenStreetMap standard tiles and public Nominatim.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "false: no map views, no geocoding endpoints, and no tile origin in the app's img-src."
        },
        "tiles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "attribution"
          ],
          "description": "The one tile source of this installation. Every browser that opens a map loads tiles from it, so the URL is public: never put a secret key in it.",
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 300,
              "pattern": "^https://([a-z0-9-]*\\{s\\}[a-z0-9-]*\\.)?[a-z0-9.-]+(:[0-9]+)?/[^\\s$\"'<>]*\\{z\\}([^\\s$\"'<>]*\\{x\\}[^\\s$\"'<>]*\\{y\\}|[^\\s$\"'<>]*\\{y\\}[^\\s$\"'<>]*\\{x\\})[^\\s$\"'<>]*$",
              "default": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
              "description": "An https tile URL template with {z}, {x} and {y} ({z}/{y}/{x} is accepted too), and {s} when subdomains are set. No ${VAR}: the browser reads it."
            },
            "attribution": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "default": "© OpenStreetMap contributors",
              "description": "Shown on every map, as the tile provider's terms require."
            },
            "max_zoom": {
              "type": "integer",
              "minimum": 1,
              "maximum": 22,
              "default": 19
            },
            "subdomains": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,20}$"
              },
              "description": "Values for {s} in url; the url must contain {s} when this is set, and the other way round."
            },
            "kind": {
              "enum": [
                "raster",
                "vector"
              ],
              "default": "raster",
              "description": "raster: image tiles drawn by Leaflet. vector: Mapbox vector tiles drawn by protomaps-leaflet (a Protomaps extract served as {z}/{x}/{y})."
            },
            "cache_tiles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300,
              "default": 300,
              "description": "How many tiles the person has already seen the service worker keeps (least recently used out). The app never prefetches tiles."
            }
          }
        },
        "geocoder": {
          "type": "object",
          "additionalProperties": false,
          "description": "Address search and reverse lookup, through the kernel (GET /api/v1/geo/search and /geo/reverse): the provider never sees the person's IP.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "provider": {
              "enum": [
                "nominatim",
                "photon"
              ],
              "default": "nominatim"
            },
            "url": {
              "type": "string",
              "maxLength": 300,
              "pattern": "^https://[a-z0-9.-]+(:[0-9]+)?(/[^\\s$\"'<>?#{}]*)?$",
              "description": "Base URL of the provider. Default: https://nominatim.openstreetmap.org for nominatim, https://photon.komoot.io for photon. A self-hosted Nominatim goes here."
            },
            "rate_per_second": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 50,
              "default": 1,
              "description": "Requests per second this kernel sends to the provider. Public Nominatim allows at most 1."
            },
            "cache_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 30,
              "description": "How long an answer is reused before the provider is asked again."
            },
            "contact": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[^\\s$\"<>]+$",
              "description": "An email or https URL the provider can reach the operator at; it goes in the User-Agent with the kernel version and auth.issuer."
            },
            "countries": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 20,
              "items": {
                "type": "string",
                "pattern": "^[a-z]{2}$"
              },
              "default": [
                "id"
              ],
              "description": "ISO 3166-1 alpha-2 codes, lower case, that results are limited to."
            }
          }
        }
      }
    }
  },
  "$defs": {
    "auth_binding": {
      "type": "object",
      "description": "Field name → value: a ${VAR} reference, or a literal for a field that is not secret",
      "additionalProperties": {
        "type": [
          "string",
          "number"
        ]
      }
    }
  }
}